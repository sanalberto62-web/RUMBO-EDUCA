<script>
const $=id=>document.getElementById(id);
const pages=[...document.querySelectorAll('section.page')];
document.querySelectorAll('.nav button').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.nav button').forEach(x=>x.classList.toggle('active',x===b));pages.forEach(p=>p.classList.toggle('active',p.id===b.dataset.page));if(b.dataset.page==='admin')renderAdmin();}));
const history=[
{date:'Siglos V–IV a. C.',name:'Atomismo griego: Leucipo y Demócrito',idea:'La materia estaría compuesta por átomos indivisibles y vacío. Las diferencias entre materiales se explicarían por la forma, el orden y la disposición de sus partículas.',evidence:'Fue una propuesta racional y filosófica, no una teoría experimental en el sentido moderno. No había instrumentos ni métodos cuantitativos para observar átomos o contrastar predicciones específicas.',limit:'No explicaba leyes químicas cuantitativas ni contaba con pruebas directas. Su importancia es haber planteado una visión corpuscular de la materia.'},
{date:'Siglo IV a. C.',name:'Aristóteles: materia continua',idea:'Propuso que la materia no está formada por átomos indivisibles y rechazó el vacío. En la tradición aristotélica, los materiales se asociaban con tierra, agua, aire y fuego, además de cualidades.',evidence:'Su enfoque se apoyaba en razonamientos filosóficos y observaciones cotidianas, no en mediciones de masa o composición con precisión moderna.',limit:'Su influencia histórica fue enorme, pero el esquema de cuatro elementos no describe los elementos químicos ni las reacciones según la ciencia actual.'},
{date:'Siglos XVII–XVIII',name:'Corpuscularismo y química cuantitativa',idea:'Pensadores como Boyle y Newton exploraron explicaciones corpusculares. La química avanzó con balanzas, gases, combustión y mediciones reproducibles.',evidence:'La precisión de las medidas de masa y de los gases hizo posible formular leyes cuantitativas de combinación química.',limit:'Todavía no se conocía la estructura interna del átomo ni existía evidencia de electrones o núcleo.'},
{date:'1803–1808',name:'John Dalton: teoría atómica química',idea:'Los elementos están formados por átomos; los compuestos se forman en proporciones enteras simples. Los átomos de un elemento se distinguían de los de otro por sus masas y propiedades.',evidence:'Relacionó la ley de conservación de la masa (Lavoisier), las proporciones definidas (Proust) y las proporciones múltiples con datos químicos y masas relativas.',limit:'Los átomos no son indivisibles: contienen partículas subatómicas. Además, los átomos de un mismo elemento pueden diferir en masa por sus isótopos.'},
{date:'1897–1904',name:'J. J. Thomson: electrón y modelo del “budín de pasas”',idea:'Los rayos catódicos se comportaban como partículas negativas presentes en distintos materiales. Thomson propuso electrones incrustados en una distribución positiva difusa.',evidence:'Midió la desviación de rayos catódicos en campos eléctricos y magnéticos y obtuvo una relación carga/masa (e/m) mucho mayor que la de iones conocidos.',limit:'El modelo no explicaba la dispersión de partículas alfa observada después por Geiger y Marsden.'},
{date:'1909–1911',name:'Rutherford: modelo nuclear',idea:'La mayor parte de la masa y la carga positiva del átomo se concentran en un núcleo diminuto; gran parte del volumen atómico es espacio en el que la probabilidad de encontrar electrones no equivale a una masa compacta.',evidence:'La mayoría de partículas alfa atravesó una lámina de oro; una pequeña fracción se desvió mucho y unas pocas retrocedieron. Una carga positiva extendida no podía explicar esos rebotes.',limit:'La física clásica no explicaba por qué los electrones acelerados no perdían energía y caían al núcleo, ni las líneas espectrales discretas.'},
{date:'1913',name:'Niels Bohr: niveles de energía',idea:'Para el hidrógeno, los electrones solo pueden ocupar ciertos estados de energía. Al cambiar de nivel, absorben o emiten fotones con energías definidas.',evidence:'Su modelo explicó con éxito las líneas espectrales del hidrógeno mediante niveles cuantizados y la relación entre la diferencia de energía y la frecuencia de la luz.',limit:'No describe con precisión átomos con varios electrones y sus órbitas definidas no representan la descripción cuántica actual.'},
{date:'1916–1924',name:'Sommerfeld y de Broglie: ampliaciones y ondas',idea:'Sommerfeld amplió el modelo de Bohr; de Broglie propuso que la materia tiene propiedades ondulatorias, con longitud de onda relacionada con el momento.',evidence:'La difracción de electrones, observada más tarde por Davisson y Germer, confirmó que los electrones pueden mostrar comportamiento ondulatorio.',limit:'Las órbitas semiclásicas fueron sustituidas por una formulación cuántica más general.'},
{date:'1925–1927',name:'Mecánica cuántica: Heisenberg, Schrödinger, Born y otros',idea:'El electrón se describe mediante estados cuánticos. Los orbitales son funciones matemáticas que permiten calcular probabilidades de resultados de medición; no son trayectorias planetarias.',evidence:'La teoría explicó espectros, enlaces y resultados de experimentos de difracción y otros fenómenos. Born interpretó probabilísticamente la función de onda; Heisenberg formuló límites fundamentales para pares de observables.',limit:'La mecánica cuántica no ofrece una trayectoria clásica exacta para el electrón. Sus predicciones son probabilísticas y se contrastan estadísticamente.'},
{date:'1932',name:'James Chadwick: neutrón',idea:'El núcleo contiene partículas neutras, además de protones. Los neutrones ayudan a explicar masas nucleares e isótopos.',evidence:'Bombardeó berilio con partículas alfa; la radiación penetrante resultante expulsaba protones al incidir sobre parafina. El análisis de energía y momento favoreció la hipótesis de una partícula neutra de masa semejante a la del protón.',limit:'El neutrón no es elemental en la descripción actual: está compuesto por quarks. El descubrimiento tampoco resolvió por sí solo la fuerza nuclear.'},
{date:'Desde mediados del siglo XX hasta hoy',name:'Modelo cuántico y estructura subatómica',idea:'Los átomos tienen núcleo con protones y neutrones (con excepciones isotópicas) y electrones en estados cuánticos. Protones y neutrones están hechos de quarks unidos por gluones.',evidence:'Espectroscopia, dispersión de electrones, aceleradores, detectores, experimentos de física nuclear y pruebas de precisión han puesto a prueba esta descripción.',limit:'El modelo estándar describe partículas e interacciones fundamentales conocidas, pero quedan preguntas abiertas, como la naturaleza de la materia oscura y la integración completa con la gravedad.'}
];
function renderHistory(){const t=$('timeline');t.innerHTML='';history.forEach((h,i)=>{const d=document.createElement('div');d.className='event'+(i===0?' selected':'');d.innerHTML=`<strong>${h.date}</strong><b>${h.name}</b><p>${h.idea.slice(0,125)}…</p>`;d.onclick=()=>{document.querySelectorAll('#timeline .event').forEach(x=>x.classList.remove('selected'));d.classList.add('selected');showHistory(i)};t.appendChild(d)});showHistory(0)}
function showHistory(i){const h=history[i];$('historyDetail').innerHTML=`<h3>${h.name}</h3><p><b>Propuesta:</b> ${h.idea}</p><p><b>¿En qué se apoyó?</b> ${h.evidence}</p><p><b>Limitaciones y evolución:</b> ${h.limit}</p>`}
const experiments=[
{year:'1789',title:'Lavoisier: conservación de la masa',people:'Antoine Lavoisier',how:'Realizó reacciones en recipientes cerrados y pesó el conjunto antes y después. Controló el intercambio de materia con el entorno y estudió la combustión como reacción con oxígeno.',observe:'En un sistema cerrado, la masa total de reactivos y productos se conserva dentro de la precisión de las mediciones.',infer:'La materia no desaparece durante una reacción química ordinaria: los átomos se reorganizan. Esta ley fue una base cuantitativa para la química moderna, aunque por sí sola no demuestra que los átomos sean esferas indivisibles.',limit:'Las reacciones nucleares pueden transformar masa en energía; la conservación pertinente en física moderna incluye la energía total.'},
{year:'1803–1808',title:'Dalton: proporciones múltiples',people:'John Dalton',how:'Comparó compuestos formados por los mismos elementos, midió masas que se combinaban y buscó relaciones simples entre ellas. Por ejemplo, distintas proporciones de carbono y oxígeno en monóxido y dióxido de carbono.',observe:'Las masas de un elemento que se combinan con una masa fija del otro pueden guardar relaciones de números enteros pequeños.',infer:'Una explicación útil es que los átomos se combinan en unidades discretas y en proporciones enteras. Dalton organizó una teoría atómica química a partir de leyes de composición.',limit:'Las masas atómicas de Dalton no siempre eran correctas y el átomo resultó divisible. Los isótopos muestran que los átomos de un elemento no tienen todos idéntica masa.'},
{year:'1897',title:'Rayos catódicos: descubrimiento del electrón',people:'J. J. Thomson',how:'Usó tubos de descarga con gas a baja presión y electrodos. El haz que salía del cátodo se desviaba al aplicar campos eléctricos y magnéticos. Thomson ajustó campos y condiciones para estudiar la trayectoria y calcular la relación carga/masa.',observe:'El haz se desviaba como una corriente de carga negativa; la relación carga/masa era mucho mayor que la de iones conocidos y el comportamiento no dependía del material del cátodo.',infer:'Existían partículas negativas mucho más ligeras que los átomos, presentes en la materia: los electrones. Esto refutó la indivisibilidad del átomo de Dalton.',limit:'El experimento no estableció por sí solo la carga elemental del electrón; la medición de carga se precisó posteriormente con otros métodos.'},
{year:'1909–1911',title:'Lámina de oro: dispersión de partículas alfa',people:'Hans Geiger y Ernest Marsden, bajo la dirección de Ernest Rutherford',how:'Dirigieron partículas alfa procedentes de una fuente radiactiva hacia una lámina de oro muy fina. Una pantalla fluorescente permitía detectar destellos según el ángulo de dispersión; el equipo contó partículas que pasaban rectas, se desviaban o regresaban.',observe:'La mayoría atravesó la lámina casi sin desviarse; una fracción pequeña se desvió a grandes ángulos y una proporción diminuta retrocedió.',infer:'La carga positiva y gran parte de la masa debían estar concentradas en una región central extremadamente pequeña y densa: el núcleo. El resultado contradijo el modelo de carga positiva difusa de Thomson.',limit:'No fue una observación directa del núcleo como una fotografía. La estructura se infirió comparando los patrones de dispersión con cálculos y modelos.'},
{year:'1913',title:'Espectro del hidrógeno',people:'Niels Bohr, apoyado en los datos espectroscópicos previos',how:'Se estudió la luz emitida por hidrógeno excitado y se separó con instrumentos espectroscópicos en líneas de frecuencias concretas. Bohr propuso niveles de energía permitidos y calculó las longitudes de onda de transiciones.',observe:'El hidrógeno emite o absorbe luz en líneas discretas, no en un continuo de todas las frecuencias.',infer:'La energía atómica está cuantizada; una transición entre estados produce o absorbe un fotón con energía igual a la diferencia entre niveles.',limit:'El modelo de Bohr funciona especialmente bien para sistemas de un electrón; para átomos multielectrónicos se necesita mecánica cuántica.'},
{year:'1923–1927',title:'Difracción de electrones',people:'Clinton Davisson y Lester Germer; de Broglie había propuesto la hipótesis ondulatoria',how:'En un experimento histórico, electrones acelerados incidieron sobre un cristal de níquel. Se midió la intensidad de electrones dispersados en distintos ángulos; aparecieron máximos característicos de difracción.',observe:'Los electrones generaron un patrón de máximos y mínimos semejante al producido por ondas al interactuar con una estructura periódica.',infer:'Los electrones presentan propiedades ondulatorias; su comportamiento no se reduce al de pequeñas bolas clásicas. Esto respaldó la relación de de Broglie entre longitud de onda y momento.',limit:'La dualidad onda-partícula no significa que el electrón sea alternativamente una onda clásica o una bolita: el comportamiento se describe mediante estados cuánticos.'},
{year:'1925–1927',title:'Pruebas de la mecánica cuántica',people:'Werner Heisenberg, Erwin Schrödinger, Max Born y numerosos investigadores',how:'Se formularon teorías matemáticas y se compararon sus predicciones con espectros atómicos, difracción, intensidades de transición y resultados repetidos de medición. La interpretación de Born relacionó el módulo cuadrado de la función de onda con probabilidades.',observe:'Los datos concuerdan con distribuciones probabilísticas y niveles de energía que no se explican mediante trayectorias clásicas simples.',infer:'Los orbitales describen estados y probabilidades; el principio de incertidumbre expresa límites fundamentales para conocer simultáneamente ciertos pares de magnitudes con precisión arbitraria.',limit:'No es simplemente una falla de instrumentos: el principio forma parte de la estructura matemática de la teoría. Aun así, toda medición real tiene también incertidumbres instrumentales.'},
{year:'1932',title:'Descubrimiento del neutrón',people:'James Chadwick',how:'Bombardeó berilio con partículas alfa y estudió una radiación muy penetrante. Al dirigirla contra parafina, observó protones expulsados. Calculó que los resultados de energía y momento no encajaban con rayos gamma ordinarios, pero sí con partículas neutras de masa similar a la del protón.',observe:'La radiación no se desviaba como una partícula cargada y transfería energía suficiente para expulsar protones.',infer:'El núcleo contiene neutrones, lo que explica parte de la masa que no se justificaba solo con protones y ayuda a comprender los isótopos.',limit:'La evidencia fue indirecta: la existencia del neutrón se infirió a partir de colisiones y conservación del momento y la energía.'},
{year:'Siglo XX–XXI',title:'Dispersión profunda y quarks',people:'Equipos de SLAC y comunidades de física de partículas; teoría de quarks desarrollada por Murray Gell-Mann y George Zweig, entre otros',how:'Se aceleraron electrones a altas energías y se hicieron colisionar con protones. Se midieron ángulos y energías de electrones dispersados; a ciertas escalas, el patrón indicaba constituyentes puntuales dentro del protón.',observe:'Los resultados de dispersión inelástica profunda revelaron estructura interna del protón, compatible con constituyentes llamados partones, identificados con quarks en el marco actual.',infer:'Protones y neutrones no son partículas indivisibles: están formados por quarks unidos por gluones, descritos por la cromodinámica cuántica.',limit:'Los quarks no se observan aislados en condiciones ordinarias debido al confinamiento; su existencia y propiedades se infieren de numerosos experimentos concordantes.'}
];
function renderExperiments(){const c=$('experimentCards');c.innerHTML='';experiments.forEach((e,i)=>{const d=document.createElement('div');d.className='event'+(i===0?' selected':'');d.innerHTML=`<strong>${e.year}</strong><b>${e.title}</b><p>${e.people}</p>`;d.onclick=()=>{document.querySelectorAll('#experimentCards .event').forEach(x=>x.classList.remove('selected'));d.classList.add('selected');showExperiment(i)};c.appendChild(d)});showExperiment(0)}
function showExperiment(i){const e=experiments[i];$('experimentDetail').innerHTML=`<h3>${e.title}</h3><p><b>¿Quiénes?</b> ${e.people}</p><p><b>¿Cómo se realizó?</b> ${e.how}</p><p><b>¿Qué se observó?</b> ${e.observe}</p><p><b>¿Qué permitió inferir?</b> ${e.infer}</p><p><b>Alcance y límites:</b> ${e.limit}</p>`}
const modelText={
dalton:{title:'Dalton · esfera sólida',text:'El átomo se representa como una esfera compacta e indivisible. La teoría de Dalton explica las proporciones en que los elementos se combinan, pero no incluye estructura subatómica, isótopos ni partículas cargadas.'},
thomson:{title:'Thomson · carga positiva difusa',text:'Tras descubrir el electrón, Thomson propuso una región positiva distribuida en la que se encontraban electrones negativos. El átomo en conjunto sería neutro. El modelo no predijo la pequeña cantidad de partículas alfa que rebotaban a grandes ángulos.'},
rutherford:{title:'Rutherford · núcleo',text:'La carga positiva y casi toda la masa se concentran en un núcleo muy pequeño; los electrones ocupan la región exterior. La dispersión de partículas alfa apoyó esta estructura. El modelo clásico no explicó la estabilidad ni los espectros discretos.'},
bohr:{title:'Bohr · niveles cuantizados',text:'Para el hidrógeno, los electrones pueden ocupar ciertos niveles de energía. Al saltar entre niveles absorben o emiten fotones. Es una herramienta histórica útil, pero sus órbitas no deben confundirse con orbitales cuánticos modernos.'},
quantum:{title:'Modelo cuántico · orbitales',text:'El electrón se describe mediante una función de onda y probabilidades de medición. Un orbital no es una órbita recorrida: representa un estado cuántico con distribución espacial de probabilidad. La teoría predice espectros y propiedades químicas con gran precisión.'},
modern:{title:'Visión actual · núcleo y nube electrónica',text:'El núcleo contiene protones y neutrones, salvo excepciones como el protón aislado del hidrógeno-1; los electrones ocupan estados cuánticos. Protones y neutrones están compuestos por quarks y gluones. Las imágenes de nube son representaciones de probabilidades, no humo material.'}
};
function drawModel(k){const s=$('atomSvg');let body='';const electron=(x,y,r=7)=>`<circle cx="${x}" cy="${y}" r="${r}" fill="#53e5de" stroke="#d9fffb" stroke-width="1.2"/><text x="${x}" y="${y+3}" text-anchor="middle" font-size="9" fill="#06202b">−</text>`;const proton=(x,y,r=8)=>`<circle cx="${x}" cy="${y}" r="${r}" fill="#ff718e" stroke="#ffd4dd" stroke-width="1"/><text x="${x}" y="${y+3}" text-anchor="middle" font-size="9" fill="#3b0715">+</text>`; 
if(k==='dalton'){body=`<circle cx="210" cy="150" r="78" fill="#f5bd54" stroke="#ffe5a4" stroke-width="4"/><text x="210" y="155" text-anchor="middle" font-size="18" fill="#4b3005" font-weight="bold">ÁTOMO</text>`}
if(k==='thomson'){body=`<circle cx="210" cy="150" r="92" fill="#ffb957" fill-opacity=".65" stroke="#ffe3a5" stroke-width="3"/>`;[[165,112],[235,106],[192,164],[248,177],[153,184],[220,218],[183,83]].forEach(p=>body+=electron(...p,9));body+=`<text x="210" y="275" text-anchor="middle" fill="#dbeaf8" font-size="12">Carga positiva distribuida</text>`}
if(k==='rutherford'){body=`<circle cx="210" cy="150" r="100" fill="none" stroke="#6d94b9" stroke-dasharray="3 8" stroke-width="1.5"/>`;[[210,150,18],[201,143,9],[220,142,9],[214,160,9],[200,159,8]].forEach(p=>body+=proton(...p));[[210,50],[310,150],[210,250],[110,150]].forEach(p=>body+=electron(...p,7));body+=`<text x="210" y="286" text-anchor="middle" fill="#dbeaf8" font-size="12">Mucho espacio entre núcleo y región electrónica</text>`}
if(k==='bohr'){[42,75,105].forEach(r=>body+=`<circle cx="210" cy="150" r="${r}" fill="none" stroke="#75a6d0" stroke-width="1.5"/>`);[[210,150,16],[201,143,8],[219,158,8]].forEach(p=>body+=proton(...p));[[210,45],[285,150],[210,255],[135,150]].forEach(p=>body+=electron(...p,7));body+=`<text x="210" y="286" text-anchor="middle" fill="#dbeaf8" font-size="12">Niveles permitidos (esquema)</text>`}
if(k==='quantum'||k==='modern'){body=`<defs><radialGradient id="cloud"><stop offset="0%" stop-color="#5ce4dd" stop-opacity=".85"/><stop offset="45%" stop-color="#3bb8d1" stop-opacity=".4"/><stop offset="100%" stop-color="#3bb8d1" stop-opacity="0"/></radialGradient></defs><ellipse cx="210" cy="150" rx="118" ry="88" fill="url(#cloud)"/><ellipse cx="210" cy="150" rx="85" ry="112" fill="url(#cloud)" opacity=".7"/><ellipse cx="210" cy="150" rx="53" ry="122" fill="none" stroke="#6edddf" stroke-opacity=".45" stroke-dasharray="3 6"/>`;for(let i=0;i<10;i++){const x=185+(i%4)*13,y=128+Math.floor(i/4)*14;body+=proton(x,y,6);if(k==='modern'&&i%2===0)body+=`<circle cx="${x+6}" cy="${y+5}" r="5" fill="#d8e7f5"/>`;}body+=`<text x="210" y="286" text-anchor="middle" fill="#dbeaf8" font-size="12">Distribución de probabilidad, no trayectoria exacta</text>`}
s.innerHTML=body;$('modelExplain').innerHTML=`<h3>${modelText[k].title}</h3><p>${modelText[k].text}</p>`}
$('modelSelect').addEventListener('change',e=>drawModel(e.target.value));function revealThought(){$('thoughtAnswer').classList.remove('hide');$('thoughtAnswer').innerHTML='<p><b>Razonamiento:</b> si la carga positiva estuviera extendida y la masa no estuviera concentrada, se esperaría que las partículas alfa atravesaran la lámina con desviaciones relativamente pequeñas. Las desviaciones muy grandes y los raros retrocesos observados por Geiger y Marsden exigían una región central diminuta, masiva y positiva. La conclusión se obtuvo por inferencia a partir del patrón de dispersión.</p>'}
function updateAtom(){const p=Math.max(1,Math.min(20,+$('protons').value||1)),n=Math.max(0,+$('neutrons').value||0),e=Math.max(0,+$('electrons').value||0);const symbols=['','H','He','Li','Be','B','C','N','O','F','Ne','Na','Mg','Al','Si','P','S','Cl','Ar','K','Ca'];const charge=p-e;const ion=charge===0?'átomo neutro':charge>0?`catión ${charge===1?'+':charge+'+'}`:`anión ${Math.abs(charge)===1?'−':Math.abs(charge)+'−'}`;$('atomInfo').innerHTML=`<b>${symbols[p]||'Elemento'}:</b> Z = ${p} (identidad química) · A = ${p+n} (número másico) · carga neta = ${charge>0?'+':''}${charge}. Es ${ion}.<br><span class="muted">Los neutrones cambian el isótopo, no el elemento; los electrones cambian la carga, no el número atómico.</span>`}
