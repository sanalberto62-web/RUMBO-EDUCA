function renderQuiz(){ $('quizProgress').textContent=`${currentQuiz.length} preguntas · Banco disponible: ${questions.length}`;$('quizArea').innerHTML=currentQuiz.map((q,i)=>`<div class="question" data-index="${i}"><b>${i+1}. ${escapeHtml(q.q)}</b>${q.o.map((op,j)=>`<label class="option"><input type="radio" name="quiz${i}" value="${j}" ${answers[i]===j?'checked':''} style="width:auto;margin-right:8px">${String.fromCharCode(65+j)}. ${escapeHtml(op)}</label>`).join('')}<div id="fb${i}" class="feedback"></div><button class="secondary" onclick="checkOne(${i})">Comprobar respuesta</button></div>`).join('')+`<button class="primary" id="finishQuiz">Calificar evaluación</button>`;$('finishQuiz').addEventListener('click',finishQuiz);currentQuiz.forEach((q,i)=>document.querySelectorAll(`input[name="quiz${i}"]`).forEach(el=>el.addEventListener('change',()=>answers[i]=Number(el.value))))}
