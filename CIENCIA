const answer={q1:'b',q2:'a',q3:'c',q4:'b',q5:'a',q6:'c',q7:'a',q8:'b'};const explanations={q1:'La curva expresa la cantidad máxima que puede disolverse en condiciones definidas.',q2:'Por debajo de la curva hay menos soluto que el máximo de equilibrio.',q3:'Al bajar la solubilidad, el exceso de soluto puede cristalizar.',q4:'La solubilidad de muchos gases disminuye al aumentar la temperatura.',q5:'La condensación transforma vapor en líquido.',q6:'Al perder agua, las sales que permanecen aumentan su concentración.',q7:'La agitación suele acelerar la disolución, no modificar el equilibrio final.',q8:'La infiltración es el paso del agua hacia el interior del suelo.'};document.getElementById('grade').addEventListener('click',()=>{let n=0;for(let i=1;i<=8;i++){let q='q'+i,s=document.querySelector('input[name="'+q+'"]:checked'),f=document.getElementById('f'+i);if(s&&s.value===answer[q]){n++;f.textContent='Correcto. '+explanations[q];f.className='good'}else{f.textContent='Respuesta correcta: '+({q1:'B',q2:'A',q3:'C',q4:'B',q5:'A',q6:'C',q7:'A',q8:'B'}[q])+'. '+explanations[q];f.className='bad'}}let sc=document.getElementById('score');sc.textContent='Resultado: '+n+'/8 ('+Math.round(n/8*100)+'%).';sc.className='result '+(n>=6?'good':'bad')});document.querySelector('#quiz').addEventListener('reset',()=>setTimeout(()=>{for(let i=1;i<=8;i++){let f=document.getElementById('f'+i);f.textContent='';f.className=''}document.getElementById('score').textContent=''},0));
</script>
