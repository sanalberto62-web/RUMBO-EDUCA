const curves={
 KNO3:[[0,13.3],[20,31.6],[40,63.9],[60,110],[80,169],[100,246]],
 KCl:[[0,28],[20,34.2],[40,40.1],[60,45.8],[80,51.3],[100,56.3]],
 NaCl:[[0,35.7],[20,35.9],[40,36.4],[60,37.1],[80,38],[100,39.2]],
 Ce2SO43:[[0,10],[20,8],[40,5],[60,3],[80,2],[100,1]]
};
const colors={KNO3:'#37d49a',KCl:'#d3f36b',NaCl:'#80d9ff',Ce2SO43:'#ffbd69'};
function interp(arr,t){if(t<=arr[0][0])return arr[0][1];for(let i=1;i<arr.length;i++){if(t<=arr[i][0]){let [t0,y0]=arr[i-1],[t1,y1]=arr[i];return y0+(y1-y0)*(t-t0)/(t1-t0)}}return arr[arr.length-1][1]}
function drawSolChart(){let c=document.getElementById('solChart'),x=c.getContext('2d'),w=c.width,h=c.height,L=80,R=w-35,T=25,B=h-65;x.clearRect(0,0,w,h);x.font='16px system-ui';x.strokeStyle='#285342';x.fillStyle='#b4cfc1';for(let y=0;y<=250;y+=50){let py=B-y/260*(B-T);x.beginPath();x.moveTo(L,py);x.lineTo(R,py);x.stroke();x.fillText(y,L-48,py+5)}for(let t=0;t<=100;t+=20){let px=L+t/100*(R-L);x.beginPath();x.moveTo(px,T);x.lineTo(px,B);x.stroke();x.fillText(t+'°',px-15,B+26)}x.strokeStyle='#b4cfc1';x.beginPath();x.moveTo(L,T);x.lineTo(L,B);x.lineTo(R,B);x.stroke();x.fillStyle='#b4cfc1';x.fillText('Solubilidad (g/100 g H₂O)',L,18);x.fillText('Temperatura (°C)',R-170,h-17);Object.keys(curves).forEach(k=>{x.strokeStyle=colors[k];x.lineWidth=4;x.beginPath();curves[k].forEach((p,i)=>{let px=L+p[0]/100*(R-L),py=B-p[1]/260*(B-T);i?x.lineTo(px,py):x.moveTo(px,py)});x.stroke();let last=curves[k][curves[k].length-1],ly=B-last[1]/260*(B-T);x.fillStyle=colors[k];x.fillText(({KNO3:'KNO₃',KCl:'KCl',NaCl:'NaCl',Ce2SO43:'Ce₂(SO₄)₃'}[k]),R-125,ly-7)})}drawSolChart();
document.getElementById('simBtn').addEventListener('click',()=>{let salt=document.getElementById('salt').value,t=Number(document.getElementById('simTemp').value),wm=Number(document.getElementById('waterMass').value),sm=Number(document.getElementById('soluteMass').value),out=document.getElementById('simResult');if(!Number.isFinite(t)||t<0||t>100||!Number.isFinite(wm)||wm<=0||!Number.isFinite(sm)||sm<0){out.textContent='Introduce una temperatura entre 0 y 100 °C, una masa de agua positiva y una masa de soluto no negativa.';out.className='result bad';return}let s=interp(curves[salt],t),max=s*wm/100,diss=Math.min(sm,max),left=Math.max(0,sm-max),state=sm<max?'insaturada':Math.abs(sm-max)<1e-8?'saturada':'se alcanza la saturación y queda soluto sin disolver';out.innerHTML='<strong>Solubilidad estimada:</strong> '+s.toFixed(2)+' g por 100 g de agua.<br><strong>Capacidad máxima estimada para '+wm+' g de agua:</strong> '+max.toFixed(2)+' g de soluto.<br><strong>Soluto añadido:</strong> '+sm.toFixed(2)+' g.<br><strong>Resultado:</strong> '+state+'.<br><strong>Puede disolverse:</strong> '+diss.toFixed(2)+' g.<br><strong>Queda sin disolver:</strong> '+left.toFixed(2)+' g.';out.className='result '+(left>0?'bad':'good')});
document.getElementById('relationBtn').addEventListener('click',()=>{let v=document.getElementById('relationPick').value,o=document.getElementById('relationResult');o.textContent=v==='b'?'Correcto. Al perder solvente, la concentración aumenta; al llegar a saturación, puede comenzar la cristalización.':v?'No es correcto. El agua suele evaporarse mientras la sal permanece disuelta hasta que se alcance la saturación.':'Selecciona una opción.';o.className='result '+(v==='b'?'good':'bad')});
