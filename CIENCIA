<script>
const $ = (id) => document.getElementById(id);
const properties=[
{id:'densidad',name:'Densidad',kind:'Física intensiva',def:'Relación entre masa y volumen: ρ = m/V. En una muestra homogénea, a temperatura y presión fijadas, ayuda a diferenciar materiales.',units:'kg/m³, g/cm³ o g/mL',example:'Una muestra de 54 g ocupa 20 mL: ρ = 54/20 = 2,7 g/mL.',caution:'La temperatura puede modificar el volumen y, por tanto, la densidad. La flotación también depende de la densidad del fluido.'},
{id:'fusion',name:'Punto de fusión',kind:'Física intensiva',def:'Temperatura a la que sólido y líquido coexisten en equilibrio a una presión determinada.',units:'°C o K',example:'El hielo puro funde cerca de 0 °C a 1 atm.',caution:'Las impurezas suelen modificar y ampliar el intervalo de fusión; no se debe comparar sin considerar presión y pureza.'},
{id:'ebullicion',name:'Punto de ebullición',kind:'Física intensiva',def:'Temperatura a la que la presión de vapor del líquido iguala la presión externa y la vaporización ocurre en todo el líquido.',units:'°C o K, indicando presión',example:'El agua pura hierve cerca de 100 °C a 1 atm.',caution:'A menor presión externa, el agua hierve a menor temperatura. No es una constante independiente de las condiciones.'},
{id:'solubilidad',name:'Solubilidad',kind:'Física intensiva condicionada',def:'Cantidad máxima de soluto que se disuelve en una cantidad definida de disolvente a una temperatura y presión dadas, formando una disolución en equilibrio.',units:'g soluto/100 g disolvente, mol/L u otras',example:'La solubilidad de muchas sales aumenta al calentar, aunque existen excepciones.',caution:'Distingue solubilidad de velocidad de disolución. Agitar o pulverizar puede acelerar el proceso sin cambiar necesariamente la solubilidad de equilibrio.'},
{id:'dureza',name:'Dureza',kind:'Mecánica',def:'Resistencia de un material a la deformación plástica, rayado o indentación; el significado exacto depende del ensayo.',units:'Escalas Mohs, Vickers, Brinell, Rockwell',example:'El diamante raya el vidrio, pero la dureza medida depende de la escala y del método.',caution:'No confundas dureza con tenacidad: un material duro puede ser frágil.'},
{id:'tenacidad',name:'Tenacidad',kind:'Mecánica',def:'Capacidad de absorber energía y deformarse antes de fracturarse. En mecánica, se relaciona con el área bajo la curva esfuerzo-deformación hasta la fractura.',units:'J/m³ para tenacidad volumétrica',example:'Un metal dúctil puede absorber energía por deformación antes de romperse.',caution:'No equivale a dureza ni a resistencia máxima.'},
{id:'fragilidad',name:'Fragilidad',kind:'Mecánica',def:'Tendencia a fracturarse con poca deformación plástica.',units:'No tiene una unidad única; se evalúa con ensayos',example:'El vidrio común suele fracturarse sin deformarse plásticamente de manera apreciable.',caution:'Fragilidad no significa necesariamente poca dureza.'},
{id:'ductilidad',name:'Ductilidad',kind:'Mecánica',def:'Capacidad de deformarse plásticamente bajo tracción y formar hilos antes de romperse.',units:'% de elongación o reducción de área',example:'El cobre puede estirarse para producir alambres.',caution:'Depende de la temperatura, estructura y tratamiento del material.'},
{id:'maleabilidad',name:'Maleabilidad',kind:'Mecánica',def:'Capacidad de deformarse plásticamente por compresión y formar láminas.',units:'Ensayos de deformación; no una unidad universal',example:'El oro es muy maleable y puede convertirse en láminas finas.',caution:'No es lo mismo que ductilidad: una describe láminas y la otra hilos.'},
{id:'conductividad',name:'Conductividad eléctrica',kind:'Eléctrica',def:'Capacidad para transportar corriente eléctrica; es la inversa de la resistividad.',units:'S/m',example:'Los metales suelen conducir bien; las disoluciones iónicas conducen por el movimiento de iones.',caution:'La conductividad depende de temperatura, composición, estado físico y concentración en disoluciones.'},
{id:'termica',name:'Conductividad térmica',kind:'Térmica',def:'Capacidad de transferir energía térmica por conducción bajo un gradiente de temperatura.',units:'W/(m·K)',example:'El cobre conduce calor mucho mejor que la madera seca.',caution:'No es lo mismo que calor específico: una describe transporte de calor y el otro energía para cambiar temperatura.'},
{id:'calorespecifico',name:'Calor específico',kind:'Térmica',def:'Energía necesaria para elevar en un kelvin la temperatura de una unidad de masa de una sustancia, sin cambio de fase.',units:'J/(kg·K)',example:'El agua tiene un calor específico alto comparado con muchos materiales comunes.',caution:'Depende de la temperatura y de las condiciones de medición.'},
{id:'viscosidad',name:'Viscosidad',kind:'Fluidez',def:'Medida de la resistencia interna de un fluido a fluir o deformarse por cizalla.',units:'Pa·s (dinámica); m²/s (cinemática)',example:'La miel suele fluir más lentamente que el agua en condiciones similares.',caution:'La viscosidad cambia con temperatura y, en algunos fluidos, con la velocidad de deformación.'},
{id:'volatilidad',name:'Volatilidad / presión de vapor',kind:'Equilibrio de fases',def:'Tendencia de una sustancia a pasar a fase vapor. A una temperatura dada, una presión de vapor mayor suele indicar mayor volatilidad.',units:'Pa o kPa para presión de vapor',example:'El éter etílico es mucho más volátil que el agua a temperatura ambiente.',caution:'La evaporación ocurre por la superficie incluso por debajo del punto de ebullición.'},
{id:'indice',name:'Índice de refracción',kind:'Óptica',def:'Relación entre la velocidad de la luz en el vacío y su velocidad de fase en el medio: n = c/v.',units:'Adimensional',example:'Puede ayudar a caracterizar líquidos transparentes con un refractómetro.',caution:'Depende de longitud de onda, temperatura y composición.'},
{id:'magnetismo',name:'Respuesta magnética',kind:'Magnética',def:'Respuesta de un material a un campo magnético; puede ser diamagnética, paramagnética, ferromagnética y otras.',units:'Depende de la magnitud medida',example:'Hierro, cobalto y níquel presentan ferromagnetismo en condiciones apropiadas.',caution:'No todos los metales son atraídos con fuerza por un imán.'},
{id:'reaccion',name:'Reactividad química',kind:'Química',def:'Tendencia de una sustancia a experimentar transformación química con otras sustancias o bajo condiciones determinadas.',units:'No tiene una unidad única',example:'El sodio reacciona vigorosamente con agua; el oro es relativamente poco reactivo en muchas condiciones.',caution:'La reactividad depende del reactivo, concentración, temperatura, superficie y medio. No se comprueba mediante ensayos improvisados.'},
{id:'acidez',name:'Acidez / basicidad',kind:'Química',def:'En disoluciones acuosas diluidas, el pH se relaciona con la actividad de los iones hidrógeno; pH menor que 7 suele ser ácido y mayor que 7 básico a 25 °C.',units:'pH (adimensional)',example:'Una disolución de ácido acético diluido tiene pH menor que 7.',caution:'El pH neutro depende de la temperatura; no todas las sustancias se caracterizan adecuadamente con una simple medida de pH.'},
{id:'organoleptica',name:'Propiedades organolépticas',kind:'Sensorial',def:'Color, apariencia y otras características percibidas por los sentidos; en ciencia se registran con protocolos controlados.',units:'Escalas descriptivas o instrumentos',example:'El color puede ser una pista inicial, pero no identifica de forma segura una sustancia.',caution:'Nunca pruebes ni inhales directamente una sustancia desconocida. En el laboratorio, no se usa el gusto y no se huele de forma directa.'},
{id:'elasticidad',name:'Elasticidad',kind:'Mecánica',def:'Capacidad de recuperar la forma original al retirar una fuerza, dentro del régimen elástico.',units:'Módulo elástico en Pa',example:'Un resorte se alarga bajo carga y puede recuperar su longitud si no supera su límite elástico.',caution:'No equivale a flexibilidad ni plasticidad; exceder el límite elástico puede producir deformación permanente.'},
{id:'presionvapor',name:'Presión de vapor',kind:'Equilibrio de fases',def:'Presión ejercida por el vapor en equilibrio con su fase condensada a una temperatura dada.',units:'Pa, kPa o mmHg',example:'A la misma temperatura, un líquido con mayor presión de vapor tiende a ser más volátil.',caution:'Aumenta generalmente con la temperatura; no es igual a la presión total del recipiente en todas las situaciones.'},
{id:'densidadrel',name:'Densidad relativa',kind:'Comparativa',def:'Cociente entre la densidad de una sustancia y la densidad de una referencia especificada; no tiene unidades.',units:'Adimensional',example:'Para líquidos y sólidos se suele usar agua como referencia, indicando temperatura.',caution:'No escribas unidades para un cociente de densidades y especifica siempre la referencia.'}
];
const props=$('propertyCards');props.innerHTML=properties.map(p=>`<button class="tile" style="text-align:left;color:var(--ink);background:linear-gradient(145deg,#fff,#f0f9ff)" onclick="showProperty('${p.id}')"><span class="pill">${p.kind}</span><h3 style="margin-top:9px">${p.name}</h3><span class="muted" style="font-weight:500">Ver explicación →</span></button>`).join('');
function showProperty(id){const p=properties.find(x=>x.id===id);$('propertyDetail').innerHTML=`<span class="pill">${p.kind}</span><h2 style="margin-top:10px">${p.name}</h2><p>${p.def}</p><p><b>Unidades habituales:</b> ${p.units}</p><p><b>Ejemplo:</b> ${p.example}</p><div class="feedback warn"><b>Precaución conceptual:</b> ${p.caution}</div>`;}
const qOriginal=[
{id:1,topic:'Densidad',level:'medium',prompt:'Una muestra homogénea tiene masa de 72 g y volumen de 30 mL. ¿Cuál es su densidad?',options:['0,42 g/mL','2,4 g/mL','42 g/mL','102 g/mL'],correct:2,explain:'ρ = m/V = 72 g / 30 mL = 2,4 g/mL. Comprueba que la unidad sea masa/volumen.'},
{id:2,topic:'Intensivas y extensivas',level:'medium',prompt:'Se divide una muestra de cobre pura en dos partes iguales, manteniendo la misma temperatura y presión. ¿Qué propiedad permanece igual en ambas partes?',options:['Masa','Volumen','Densidad','Cantidad total de energía'],correct:3,explain:'La densidad es intensiva: no depende de la cantidad de muestra, si la composición y las condiciones se mantienen.'},
{id:3,topic:'Puntos de cambio de estado',level:'hard',prompt:'Un líquido puro hierve a 86 °C en una ciudad situada a gran altitud. ¿Cuál es la interpretación más rigurosa?',options:['El líquido dejó de ser puro','La presión externa puede ser menor que 1 atm','La masa de la muestra es demasiado baja','El punto de ebullición nunca depende de la presión'],correct:2,explain:'La ebullición ocurre cuando la presión de vapor iguala la presión externa. A menor presión, suele bajar la temperatura de ebullición.'},
{id:4,topic:'Solubilidad',level:'hard',prompt:'Al agitar una mezcla de agua y un sólido, el sólido se disuelve más rápido. ¿Qué conclusión está mejor sustentada?',options:['La solubilidad de equilibrio siempre aumentó','La agitación puede aumentar la velocidad de disolución, no necesariamente la solubilidad de equilibrio','El sólido se volvió menos denso','Ocurrió necesariamente una reacción química'],correct:2,explain:'La velocidad de disolución y la solubilidad de equilibrio son conceptos distintos. La agitación renueva el contacto entre soluto y disolvente.'},
{id:5,topic:'Dureza y tenacidad',level:'hard',prompt:'Un material raya otro, pero se rompe con facilidad al recibir un golpe. ¿Qué afirmación es válida?',options:['Debe ser dúctil','La dureza alta garantiza alta tenacidad','Dureza y tenacidad describen propiedades mecánicas diferentes','La fragilidad mide la conductividad'],correct:3,explain:'La dureza mide resistencia al rayado/indentación; la tenacidad describe la energía absorbida antes de fracturarse. No son equivalentes.'},
{id:6,topic:'Conductividad',level:'medium',prompt:'¿Cuál afirmación distingue correctamente la conductividad eléctrica de la térmica?',options:['Ambas se expresan siempre en S/m','La eléctrica describe transporte de carga; la térmica, transferencia de energía por conducción','La conductividad térmica es el calor específico','Solo los gases conducen electricidad'],correct:2,explain:'Son magnitudes diferentes: la conductividad eléctrica se mide en S/m y la térmica en W/(m·K).'},
{id:7,topic:'Calor específico',level:'hard',prompt:'Dos bloques de igual masa reciben la misma energía y no cambian de fase. El bloque A aumenta 10 °C y el B aumenta 5 °C. ¿Qué se deduce?',options:['A tiene el doble de calor específico que B','B tiene aproximadamente el doble de calor específico que A','Tienen el mismo calor específico','B necesariamente tiene mayor densidad'],correct:2,explain:'Q = m·c·ΔT. Para igual Q y m, c es inversamente proporcional al cambio de temperatura: B tiene el doble de c que A.'},
{id:8,topic:'Volatilidad',level:'medium',prompt:'A una misma temperatura, el líquido X presenta mayor presión de vapor que el líquido Y. En general, ¿qué se puede inferir?',options:['X suele ser más volátil que Y','X tiene necesariamente mayor densidad','Y debe ser un sólido','X tiene siempre mayor punto de ebullición'],correct:1,explain:'A la misma temperatura, mayor presión de vapor suele indicar mayor volatilidad. No permite inferir por sí sola densidad ni otros datos.'},
{id:9,topic:'Gráfico de densidad',level:'hard',prompt:'En un gráfico masa (eje y) frente a volumen (eje x) para un material homogéneo, ¿qué representa la pendiente de una recta que pasa por el origen?',options:['Volumen específico','Densidad','Temperatura de fusión','Solubilidad'],correct:2,explain:'La pendiente es Δm/ΔV, es decir, masa por volumen: densidad. Las unidades serían, por ejemplo, g/mL.'},
{id:10,topic:'Propiedades químicas',level:'medium',prompt:'¿Cuál es un ejemplo de propiedad química?',options:['Color de una pieza de cobre','Densidad del etanol','Tendencia del hierro a oxidarse bajo ciertas condiciones','Punto de fusión del hielo'],correct:3,explain:'La reactividad y la tendencia a oxidarse implican transformación química. Color, densidad y punto de fusión son propiedades físicas.'},
{id:11,topic:'Densidad relativa',level:'hard',prompt:'La densidad relativa de una muestra respecto al agua (a la temperatura especificada) es 0,80. ¿Qué significa?',options:['La densidad de la muestra es 0,80 g','La densidad de la muestra es 0,80 veces la del agua de referencia','La muestra tiene masa de 0,80 kg siempre','La muestra es soluble en agua'],correct:2,explain:'Densidad relativa = densidad de muestra / densidad de referencia. Es un cociente sin unidades; aquí vale 0,80.'},
{id:12,topic:'Identificación',level:'hard',prompt:'Dos líquidos son transparentes e incoloros. ¿Qué procedimiento ofrece evidencia más sólida para distinguirlos?',options:['Probarlos con la lengua','Olerlos directamente','Comparar solo el volumen de cada recipiente','Medir varias propiedades bajo condiciones controladas y contrastarlas con referencias confiables'],correct:4,explain:'El aspecto visual no basta. Combinar densidad, índice de refracción o punto de ebullición medidos con seguridad produce evidencia más sólida.'},
{id:13,topic:'Ductilidad y maleabilidad',level:'medium',prompt:'La capacidad de estirar un metal para formar alambres se denomina:',options:['Maleabilidad','Ductilidad','Fragilidad','Volatilidad'],correct:2,explain:'La ductilidad es la deformación plástica bajo tracción para formar hilos; la maleabilidad se refiere a formar láminas por compresión.'},
{id:14,topic:'Índice de refracción',level:'hard',prompt:'¿Cuál es una limitación importante al comparar índices de refracción de dos líquidos?',options:['Es una propiedad que siempre tiene unidades de kg','No cambia nunca con la temperatura ni con la luz usada','Puede depender de la temperatura y de la longitud de onda','Solo se puede medir en sólidos opacos'],correct:3,explain:'El índice de refracción depende de la longitud de onda y de la temperatura; las comparaciones deben controlar esas variables.'},
{id:15,topic:'pH',level:'hard',prompt:'A 25 °C, una disolución acuosa tiene pH 3 y otra pH 5. ¿Cómo se compara la actividad de H⁺, de forma aproximada en términos de concentración para disoluciones diluidas?',options:['La de pH 3 es 2 veces mayor','La de pH 3 es 100 veces mayor','La de pH 5 es 100 veces mayor','Son iguales'],correct:2,explain:'La escala es logarítmica: una diferencia de 2 unidades corresponde a un factor de 10² = 100 en actividad de H⁺.'},
{id:16,topic:'Conductividad de disoluciones',level:'hard',prompt:'Una disolución acuosa conduce electricidad mejor al aumentar la concentración de una sal soluble, en un rango diluido. ¿Cuál explicación es la más adecuada?',options:['Aumenta el número de portadores iónicos móviles por volumen','Las moléculas de agua se convierten en metales','La densidad se vuelve cero','La sal desaparece sin disolverse'],correct:1,explain:'Los iones móviles transportan carga. En rangos diluidos, mayor concentración suele elevar la conductividad; a concentraciones altas la relación no es siempre lineal.'},
{id:17,topic:'Estado físico',level:'medium',prompt:'¿Qué descripción de partículas corresponde mejor a un gas?',options:['Partículas muy próximas y ordenadas que vibran en posiciones fijas','Partículas próximas que se deslizan unas sobre otras','Partículas muy separadas, con movimiento desordenado y gran libertad','Partículas inmóviles sin energía'],correct:3,explain:'En el modelo cinético, las partículas de un gas están separadas y se mueven continuamente de manera desordenada.'},
{id:18,topic:'Propiedad específica',level:'hard',prompt:'¿Cuál opción es la mejor advertencia al usar una sola propiedad para identificar una sustancia?',options:['Una sola medición siempre prueba identidad absoluta','Las propiedades no dependen nunca de condiciones','Varias sustancias pueden compartir un valor parecido; conviene combinar propiedades y controlar condiciones','Las propiedades físicas no se pueden medir'],correct:3,explain:'Las propiedades características son útiles, pero los valores pueden coincidir o variar por temperatura, presión, pureza e incertidumbre experimental.'}
];
