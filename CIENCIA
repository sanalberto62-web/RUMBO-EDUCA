inverse": false}, {"n": 63, "text": "Me integro a grupos que brindan ayuda a los necesitados.", "factor": "Moralidad", "inverse": false}, {"n": 64, "text": "Cuando algo no sale como yo espero, recapacito sobre los errores que puede haber tenido.", "factor": "Pensamiento crítico", "inverse": false}, {"n": 65, "text": "Identifico los aspectos positivos de situaciones vividas con anterioridad.", "factor": "Introspección", "inverse": false}, {"n": 66, "text": "En las relaciones significativas que mantengo, me intereso por conocer los ideales y objetivos del otro.", "factor": "Interacción", "inverse": false}, {"n": 67, "text": "Mis compañeros me eligen para dirigirlos en actividades.", "factor": "Iniciativa", "inverse": false}, {"n": 68, "text": "Necesito la aprobación de los demás para tomar decisiones importantes", "factor": "Independencia", "inverse": true}, {"n": 69, "text": "Me siento estresado al enfrentar situaciones adversas.", "factor": "Humor", "inverse": false}, {"n": 70, "text": "Cuando tengo un problema planteo diferentes alternativas de solución.", "factor": "Creatividad", "inverse": false}, {"n": 71, "text": "Desconfío de las personas que se acercan a pedirme ayuda caritativa.", "factor": "Moralidad", "inverse": true}, {"n": 72, "text": "Reflexiono sobre mis creencias.", "factor": "Pensamiento crítico", "inverse": false}, {"n": 73, "text": "Me cuesta trabajo darme cuenta de los errores que he cometido anteriormente.", "factor": "Introspección", "inverse": true}, {"n": 74, "text": "Me intereso por el bienestar de las personas que conozco.", "factor": "Interacción", "inverse": false}, {"n": 75, "text": "Cuando soy líder en un grupo, propongo ideas para el logro de los objetivos", "factor": "Iniciativa", "inverse": false}, {"n": 76, "text": "Me siento mejor cuando trabajo de forma independiente.", "factor": "Independencia", "inverse": false}, {"n": 77, "text": "Hago chistes acerca de situaciones de mi vida cotidiana.", "factor": "Humor", "inverse": false}, {"n": 78, "text": "Presento mis trabajos en clase de forma novedosa.", "factor": "Creatividad", "inverse": false}, {"n": 79, "text": "Sacrifico momentos que me generan placer para obtener, más adelante grandes satisfacciones.", "factor": "Moralidad", "inverse": false}, {"n": 80, "text": "Se me dificulta adaptarme a nuevos lugares.", "factor": "Pensamiento crítico", "inverse": true}, {"n": 81, "text": "Echo la culpa a los demás por los problemas que me suceden.", "factor": "Introspección", "inverse": true}, {"n": 82, "text": "En las relaciones que establezco tengo en cuenta el bienestar propio.", "factor": "Interacción", "inverse": false}, {"n": 83, "text": "Me gusta enfrentar retos.", "factor": "Iniciativa", "inverse": false}, {"n": 84, "text": "Las orientaciones del docente son imprescindibles para mi aprendizaje.", "factor": "Independencia", "inverse": true}, {"n": 85, "text": "Trato de mejorar los aspectos negativos de mí mismo.", "factor": "Introspección", "inverse": false}, {"n": 86, "text": "Me disgusta cuando me exigen mucho en clases.", "factor": "Iniciativa", "inverse": true}, {"n": 87, "text": "Prefiero trabajar en grupo.", "factor": "Independencia", "inverse": true}, {"n": 88, "text": "Organizo actividades que me ayuden a mi crecimiento personal.", "factor": "Introspección", "inverse": false}, {"n": 89, "text": "Cuando reflexiono sobre mi forma de ser, tengo en cuenta las apreciaciones de los demás.", "factor": "Introspección", "inverse": false}, {"n": 90, "text": "Espero a que otros me ayuden a resolver los problemas.", "factor": "Introspección", "inverse": true}];
const DESCRIPTIONS = {"Introspección": "Reconocer cualidades, dificultades, aprendizajes y aspectos personales por mejorar.", "Interacción": "Construir vínculos de apoyo, expresar sentimientos y considerar las necesidades de otras personas.", "Iniciativa": "Planear, actuar, asumir retos y sostener acciones para avanzar hacia metas.", "Independencia": "Tomar decisiones propias, expresar opiniones y actuar con autonomía, manteniendo vínculos saludables.", "Humor": "Usar el humor y la distensión como recursos posibles ante tensiones, sin negar el dolor ni minimizar los problemas.", "Creatividad": "Explorar alternativas, adaptarse a cambios y buscar soluciones diferentes ante dificultades.", "Moralidad": "Reflexionar sobre valores, actuar con consideración y contribuir al bienestar de otras personas.", "Pensamiento crítico": "Examinar ideas, revisar creencias, analizar situaciones y considerar distintas explicaciones."};
const ACTIVITIES = {"Introspección": "Escribe tres fortalezas y un aspecto que deseas mejorar. Al final de la semana, registra una situación en la que aprendiste algo de ti.", "Interacción": "Identifica una persona adulta de confianza y dos personas de tu entorno que puedan escucharte. Practica expresar una necesidad con claridad y respeto.", "Iniciativa": "Elige una meta pequeña para los próximos siete días. Divídela en tres acciones concretas y marca cuándo realizarás cada una.", "Independencia": "Antes de una decisión cotidiana, anota opciones, consecuencias y tu razón para elegir. Pide orientación cuando sea necesario, sin ceder automáticamente tu decisión.", "Humor": "Identifica actividades saludables que te ayuden a recuperar calma. Recuerda que pedir ayuda y expresar tristeza también son formas válidas de afrontar una dificultad.", "Creatividad": "Ante un problema, escribe al menos tres soluciones posibles. Elige una que sea segura y viable, pruébala y revisa qué aprendiste.", "Moralidad": "Piensa en una situación en la que tus valores te orientaron. Escribe cómo podrías actuar con honestidad, empatía y respeto en un caso parecido.", "Pensamiento crítico": "Cuando escuches una afirmación, pregunta: ¿qué evidencia la apoya?, ¿hay otra explicación?, ¿qué información me falta?"};
const FACTORS = ["Introspección","Interacción","Iniciativa","Independencia","Humor","Creatividad","Moralidad","Pensamiento crítico"];
const answers = {};
const $ = id => document.getElementById(id);
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function show(id){$(id).classList.remove('hidden');}
function hide(id){$(id).classList.add('hidden');}
function startQuiz(){ hide('intro'); show('test'); renderQuestions(); window.scrollTo({top:0,behavior:'smooth'}); }
$('start').addEventListener('click', startQuiz);
document.addEventListener('click', function(event){ if(event.target.closest('#start')) startQuiz(); });
$('back').addEventListener('click',()=>{hide('test');show('intro');window.scrollTo({top:0,behavior:'smooth'});});
function renderQuestions(){
 $('questions').innerHTML=ITEMS.map(it=>`<article class="item" id="qbox${it.n}"><div class="itemhead"><div class="num">${it.n}</div><div class="statement">${esc(it.text)}</div></div><span class="factor-tag">${esc(it.factor)}</span><div class="scale" role="radiogroup" aria-label="Respuesta al enunciado ${it.n}">${[1,2,3,4,5].map(v=>`<label><input type="radio" name="q${it.n}" value="${v}" ${answers[it.n]===v?'checked':''}><span>${v}</span><small>${['Nunca','Casi nunca','A veces','Por lo general','Siempre'][v-1]}</small></label>`).join('')}</div></article>`).join('');
 $('questions').querySelectorAll('input[type=radio]').forEach(el=>el.addEventListener('change',e=>{const n=Number(e.target.name.slice(1));answers[n]=Number(e.target.value);updateProgress();}));
 updateProgress();
}
function updateProgress(){const count=Object.keys(answers).length;$('progressbar').style.width=(count/90*100)+'%';$('progressnum').textContent=`${count} de 90 respondidos`;}
$('calculate').addEventListener('click',()=>{
 const missing=ITEMS.filter(it=>!answers[it.n]);
 if(missing.length){$('errorbox').textContent=`Te faltan ${missing.length} enunciados por responder. Revisa las preguntas resaltadas y completa todas las respuestas.`;show('errorbox');missing.forEach(it=>$(('qbox'+it.n)).style.borderColor='#d97757');$(('qbox'+missing[0].n)).scrollIntoView({behavior:'smooth',block:'center'});return;}
 hide('errorbox');const scores={};FACTORS.forEach(f=>scores[f]=[]);
 ITEMS.forEach(it=>{let v=answers[it.n];if(it.inverse)v=6-v;scores[it.factor].push(v);});
 const means={};FACTORS.forEach(f=>means[f]=scores[f].reduce((a,b)=>a+b,0)/scores[f].length);
 $('reportname').textContent=$('participant').value.trim()?`Nombre: ${$('participant').value.trim()}`:'Informe anónimo (sin nombre)';
 $('reportdate').textContent='Fecha de elaboración: '+new Date().toLocaleDateString('es-CO',{year:'numeric',month:'long',day:'numeric'});
 $('chart').innerHTML=FACTORS.map(f=>`<div class="chartrow"><div>${esc(f)}</div><div class="charttrack"><span style="width:${means[f]/5*100}%"></span></div><div><strong>${means[f].toFixed(2).replace('.',',')}</strong></div></div>`).join('');
 $('factorresults').innerHTML=FACTORS.map(f=>`<article class="factor-result"><div class="resulttop"><h3>${esc(f)}</h3><span class="score">${means[f].toFixed(2).replace('.',',')} / 5</span></div><div class="meter"><span style="width:${means[f]/5*100}%"></span></div><p>${esc(DESCRIPTIONS[f])}</p><p><strong>Actividad sugerida:</strong> ${esc(ACTIVITIES[f])}</p></article>`).join('');
 hide('test');show('results');window.scrollTo({top:0,behavior:'smooth'});
});
$('print').addEventListener('click',()=>window.print());
$('edit').addEventListener('click',()=>{hide('results');show('test');renderQuestions();window.scrollTo({top:0,behavior:'smooth'});});
$('restart').addEventListener('click',()=>{if(confirm('¿Deseas borrar las respuestas de esta sesión y empezar de nuevo?')){Object.keys(answers).forEach(k=>delete answers[k]);$('participant').value='';$('goal').value='';$('support').value='';$('evidence').value='';hide('results');show('intro');hide('test');window.scrollTo({top:0,behavior:'smooth'});}});

});
