<script>
const $ = id => document.getElementById(id);
document.querySelectorAll('.tab').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('active',b===btn));document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id===btn.dataset.page));if(btn.dataset.page==='admin')renderAdmin();}));
function showResult(id,html){$(id).innerHTML=html;$(id).classList.remove('hide')}
function checkLimitante(){let v=$('limQuick').value;let msg=v==='h'?'<b>Correcto: H₂ es limitante.</b> 2/1 = 2 para N₂ y 3/3 = 1 para H₂; el menor cociente corresponde a H₂.':'<b>Revisa el procedimiento.</b> Compara n/co eficiente: N₂: 2/1 = 2; H₂: 3/3 = 1. El H₂ es limitante.';showResult('limFeedback',msg)}
function calculateStoich(){let mass=+$('cMass').value,purity=+$('cPurity').value,MA=+$('cMA').value,a=+$('cA').value,MB=+$('cMB').value,b=+$('cB').value,actual=$('cActual').value.trim()===''?null:+$('cActual').value;let vals=[mass,purity,MA,a,MB,b];if(vals.some(v=>!Number.isFinite(v))||mass<0||purity<0||purity>100||MA<=0||MB<=0||a<=0||b<=0||!Number.isInteger(a)||!Number.isInteger(b)||(actual!==null&&(!Number.isFinite(actual)||actual<0))){showResult('calcResult','<b>Datos inválidos.</b> Revisa que las masas no sean negativas, la pureza esté entre 0 y 100 %, y las masas molares y coeficientes sean positivos.');return}let pure=mass*purity/100,nA=pure/MA,nB=nA*b/a,theo=nB*MB;let html=`<h3>Resultados</h3><p>Masa pura de A: <strong>${pure.toFixed(4)} g</strong></p><p>Moles disponibles de A: <strong>${nA.toFixed(5)} mol</strong></p><p>Moles teóricos de B: <strong>${nB.toFixed(5)} mol</strong></p><p>Masa teórica de B: <strong>${theo.toFixed(4)} g</strong></p>`;if(actual!==null){if(theo===0)html+='<p>No se puede calcular rendimiento porque la masa teórica es cero.</p>';else{let y=actual/theo*100;html+=`<p>Rendimiento porcentual: <strong>${y.toFixed(2)} %</strong></p>`;if(y>100)html+='<p class="warning">El rendimiento supera 100 %. Verifica humedad, contaminación, pesada, pureza y supuestos del cálculo.</p>'}}html+='<p class="small muted">Modelo: n(B) = n(A) × b/a. Si hay más reactivos, este resultado solo es válido si A es el limitante y los demás están en cantidad suficiente.</p>';showResult('calcResult',html)}
function resetStoich(){$('cMass').value=50;$('cPurity').value=90;$('cMA').value=100.09;$('cA').value=1;$('cMB').value=56.08;$('cB').value=1;$('cActual').value='';$('calcResult').classList.add('hide')}
function checkPractice(){let v=+$('practiceAnswer').value;let pure=120*.9;let theo=(pure/84.01/2)*105.99;let ok=Number.isFinite(v)&&Math.abs(v-theo)<Math.max(.7,theo*.015);showResult('practiceFeedback',ok?`<b>Correcto.</b> La masa teórica es aproximadamente ${theo.toFixed(2)} g. Primero: 120 × 0,90 = 108 g de NaHCO₃; después se aplican la proporción 2:1 y las masas molares.`:`<b>Continúa el cálculo.</b> La masa pura es 108 g. Calcula 108/84,01 para obtener los moles de NaHCO₃; divide entre 2 para hallar los moles de Na₂CO₃ y multiplica por 105,99 g/mol. Resultado aproximado: <strong>${theo.toFixed(2)} g</strong>.`)}
const defaultQuestions=[
{id:'e1',type:'concept',q:'¿Qué representa el coeficiente estequiométrico en una ecuación balanceada?',opts:['La masa en gramos de la sustancia','La proporción molar entre las especies','La pureza de la sustancia','El rendimiento real'],ans:1,exp:'Los coeficientes expresan relaciones entre cantidades de sustancia en moles y entre entidades.'},
{id:'e2',type:'calc',q:'Una muestra de 80 g tiene 75 % de pureza. ¿Qué masa de sustancia pura contiene?',opts:['20 g','60 g','75 g','106,7 g'],ans:1,exp:'Masa pura = 80 × 0,75 = 60 g.'},
{id:'e3',type:'concept',q:'¿Cuál es la diferencia entre rendimiento teórico y real?',opts:['Son siempre iguales','El teórico es el máximo calculado; el real es el medido','El real siempre es mayor','El teórico depende solo de la pureza'],ans:1,exp:'El rendimiento teórico se obtiene de la estequiometría; el real se mide experimentalmente.'},
{id:'e4',type:'calc',q:'Para 2 H₂ + O₂ → 2 H₂O hay 6 mol H₂ y 2 mol O₂. ¿Cuál es el reactivo limitante?',opts:['H₂','O₂','H₂O','Ninguno'],ans:1,exp:'H₂: 6/2 = 3; O₂: 2/1 = 2. El menor cociente es O₂.'},
{id:'e5',type:'calc',q:'El rendimiento teórico es 50 g y el real 42 g. ¿Cuál es el rendimiento porcentual?',opts:['8 %','84 %','119 %','42 %'],ans:1,exp:'(42/50) × 100 = 84 %.'},
{id:'e6',type:'concept',q:'¿Qué implica un rendimiento experimental de 108 %?',opts:['Se creó materia','La reacción fue necesariamente perfecta','Debe revisarse humedad, impurezas, medición o cálculo','La pureza es 108 %'],ans:2,exp:'Un valor superior a 100 % suele revelar producto contaminado o húmedo, errores de medida o supuestos incorrectos.'},
{id:'e7',type:'concept',q:'La economía atómica de una reacción evalúa principalmente…',opts:['La rapidez de la reacción','La proporción de masa de reactivos incorporada al producto deseado','La pureza del reactivo comercial','El calor liberado'],ans:1,exp:'Es una métrica teórica que considera la masa molar del producto deseado frente a la masa total estequiométrica de reactivos.'},
{id:'e8',type:'calc',q:'CaCO₃ → CaO + CO₂. Si reaccionan 2 mol de CaCO₃ y la proporción es 1:1, ¿cuántos moles teóricos de CaO se forman?',opts:['1 mol','2 mol','3 mol','4 mol'],ans:1,exp:'La relación molar CaCO₃:CaO es 1:1, así que se forman 2 mol de CaO.'},
{id:'e9',type:'concept',q:'¿Qué describe la conversión de un reactivo?',opts:['La fracción del reactivo inicial que reaccionó','La masa molar del producto','El porcentaje de impurezas','La cantidad de solvente recuperado'],ans:0,exp:'La conversión compara cuánto reactivo se consumió con cuánto había inicialmente.'},
{id:'e10',type:'calc',q:'Una reacción tiene rendimiento teórico de 120 g y se recuperan 90 g. ¿Qué rendimiento porcentual se obtuvo?',opts:['25 %','75 %','90 %','133,3 %'],ans:1,exp:'90/120 × 100 = 75 %.'},
{id:'e11',type:'concept',q:'Si un reactivo tiene 70 % de pureza, ¿qué masa se usa para calcular sus moles disponibles?',opts:['Toda la masa de muestra sin corregir','La masa de sustancia pura, después de corregir por pureza','La masa de impurezas','La masa teórica de producto'],ans:1,exp:'Se multiplica la masa de muestra por 0,70 y luego se convierte esa masa pura a moles.'},
{id:'e12',type:'calc',q:'Para N₂ + 3 H₂ → 2 NH₃, con 3 mol de N₂ y 6 mol de H₂, ¿cuál es el limitante?',opts:['N₂','H₂','NH₃','Ninguno'],ans:1,exp:'N₂: 3/1 = 3; H₂: 6/3 = 2. H₂ es limitante.'},
{id:'e13',type:'concept',q:'¿Puede una reacción tener alta economía atómica y bajo rendimiento experimental?',opts:['No, son la misma magnitud','Sí; una es teórica y la otra depende del resultado experimental','No, si la pureza es alta','Solo en reacciones redox'],ans:1,exp:'La economía atómica depende de la ecuación y del producto deseado; el rendimiento depende de cuánto producto se obtiene realmente.'},
{id:'e14',type:'calc',q:'Si 25 g de producto real representan un rendimiento del 80 %, ¿cuál era la masa teórica?',opts:['20 g','31,25 g','45 g','200 g'],ans:1,exp:'Masa teórica = masa real / 0,80 = 25/0,80 = 31,25 g.'},
{id:'e15',type:'concept',q:'¿Qué se debe hacer antes de aplicar relaciones molares?',opts:['Multiplicar todos los subíndices por dos','Balancear correctamente la ecuación','Suponer pureza de 100 % siempre','Convertir gramos directamente a coeficientes'],ans:1,exp:'Las proporciones molares solo son válidas cuando la ecuación está balanceada.'},
{id:'e16',type:'calc',q:'Una muestra de 50 g al 80 % de pureza contiene…',opts:['10 g de sustancia pura','40 g de sustancia pura','50 g de sustancia pura','62,5 g de sustancia pura'],ans:1,exp:'50 × 0,80 = 40 g de sustancia pura.'},
{id:'e17',type:'concept',q:'¿Cuál afirmación sobre el reactivo limitante es correcta?',opts:['Siempre es el de menor masa','Es el que tiene menor masa molar','Se identifica comparando moles disponibles con coeficientes','Es el reactivo de mayor pureza'],ans:2,exp:'Se compara n disponible/coeficiente estequiométrico para cada reactivo.'},
{id:'e18',type:'concept',q:'Una baja recuperación tras filtrar y cristalizar un producto afecta directamente…',opts:['El número de Avogadro','El rendimiento aislado del proceso','La masa molar de la sustancia','La ecuación balanceada'],ans:1,exp:'Las pérdidas durante separación y purificación pueden disminuir la cantidad de producto aislado.'},
{id:'e19',type:'calc',q:'Si el producto teórico es 75 g y el rendimiento 64 %, ¿qué masa real se espera?',opts:['11 g','48 g','64 g','117,2 g'],ans:1,exp:'75 × 0,64 = 48 g.'},
{id:'e20',type:'concept',q:'¿Por qué conviene declarar la base de cálculo de una “eficiencia” de proceso?',opts:['Porque eficiencia tiene varios usos y debe especificarse el indicador','Porque elimina la necesidad de balancear','Porque siempre equivale a pureza','Porque hace innecesario medir'],ans:0,exp:'Eficiencia puede referirse a recuperación, energía, materiales u otros criterios; la definición operacional evita ambigüedad.'}
];
let questions=loadQuestions(), currentQuiz=[];function loadQuestions(){try{let x=JSON.parse(localStorage.getItem('stoichQuestions')||'null');return Array.isArray(x)&&x.length?x:defaultQuestions.map(q=>({...q,opts:[...q.opts]}))}catch(e){return defaultQuestions.map(q=>({...q,opts:[...q.opts]}))}}function persist(){localStorage.setItem('stoichQuestions',JSON.stringify(questions))}
function shuffle(a){let x=[...a];for(let i=x.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[x[i],x[j]]=[x[j],x[i]]}return x}
function startQuiz(){let mode=$('quizMode').value,count=+$('quizCount').value;let pool=questions.filter(q=>mode==='all'||q.type===mode);currentQuiz=shuffle(pool).slice(0,Math.min(count,pool.length));let area=$('quizArea');area.innerHTML='';if(!currentQuiz.length){area.textContent='No hay preguntas para esta modalidad. Añade preguntas desde el administrador.';return}currentQuiz.forEach((q,i)=>{let d=document.createElement('div');d.className='quizq';d.innerHTML=`<b>${i+1}. ${escapeHTML(q.q)}</b><div>${q.opts.map((o,j)=>`<label class="option"><input type="radio" name="quiz_${i}" value="${j}"><span>${String.fromCharCode(65+j)}. ${escapeHTML(o)}</span></label>`).join('')}</div><div id="fb_${i}" class="hide"></div>`;area.appendChild(d)});let b=document.createElement('button');b.textContent='Calificar evaluación';b.onclick=gradeQuiz;area.appendChild(b);let res=document.createElement('div');res.id='quizScore';res.className='result hide';area.appendChild(res)}
function gradeQuiz(){let score=0;currentQuiz.forEach((q,i)=>{let selected=document.querySelector(`input[name="quiz_${i}"]:checked`),ok=selected&&+selected.value===q.ans;if(ok)score++;let fb=$('fb_'+i);fb.className='feedback '+(ok?'correct':'incorrect');fb.innerHTML=`<b>${ok?'Correcto':'Incorrecto'}.</b> ${escapeHTML(q.exp)} La respuesta correcta es ${String.fromCharCode(65+q.ans)}.`});let pct=score/currentQuiz.length*100;showResult('quizScore',`<h3>Resultado: ${score}/${currentQuiz.length} (${pct.toFixed(1)} %)</h3><p>${pct>=90?'Dominio sobresaliente.':pct>=75?'Buen desempeño; revisa las explicaciones de los errores.':pct>=60?'Desempeño en desarrollo; practica los procedimientos.':'Conviene repasar fundamentos, unidades y relaciones molares antes de repetir.'}</p>`)}
function escapeHTML(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function saveQuestion(){let qtxt=$('qText').value.trim(),opts=[$('q0').value.trim(),$('q1').value.trim(),$('q2').value.trim(),$('q3').value.trim()],exp=$('qExplain').value.trim();if(!qtxt||opts.some(x=>!x)||!exp){showResult('adminMessage','Completa el enunciado, las cuatro opciones y la explicación.');return}let id=$('qId').value.trim()||('custom_'+Date.now()),obj={id,type:$('qType').value,q:qtxt,opts,ans:+$('qCorrect').value,exp};let ix=questions.findIndex(q=>q.id===id);if(ix>=0)questions[ix]=obj;else questions.push(obj);persist();clearQuestionForm();renderAdmin();showResult('adminMessage','Pregunta guardada en este navegador. Exporta el JSON para tener una copia de respaldo.')}
function clearQuestionForm(){['qText','qExplain','q0','q1','q2','q3','qId'].forEach(id=>$(id).value='');$('qType').value='concept';$('qCorrect').value='0'}
function editQuestion(id){let q=questions.find(x=>x.id===id);if(!q)return;$('qId').value=q.id;$('qText').value=q.q;$('qType').value=q.type;$('qExplain').value=q.exp;q.opts.forEach((o,i)=>$('q'+i).value=o);$('qCorrect').value=String(q.ans);document.querySelector('[data-page="admin"]').click();window.scrollTo({top:document.body.scrollHeight,behavior:'smooth'})}
function deleteQuestion(id){if(!confirm('¿Eliminar esta pregunta del banco local?'))return;questions=questions.filter(q=>q.id!==id);persist();renderAdmin()}
function renderAdmin(){$('questionList').innerHTML=questions.map(q=>`<div class="quizq"><b>${escapeHTML(q.q)}</b><div class="small muted">Tipo: ${q.type==='calc'?'Cálculo':'Conceptual'} · Respuesta: ${String.fromCharCode(65+q.ans)}</div><button class="secondary" onclick="editQuestion('${escapeHTML(q.id)}')">Editar</button><button class="danger" onclick="deleteQuestion('${escapeHTML(q.id)}')">Eliminar</button></div>`).join('')||'<p>No hay preguntas en el banco.</p>'}
function exportQuestions(){let blob=new Blob([JSON.stringify(questions,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='banco_estequiometria.json';a.click();URL.revokeObjectURL(url);showResult('adminMessage','Banco exportado. Guarda el archivo JSON como copia de seguridad.')}
function importQuestions(event){let f=event.target.files[0];if(!f)return;let r=new FileReader();r.onload=()=>{try{let data=JSON.parse(r.result);if(!Array.isArray(data)||!data.every(q=>q.q&&Array.isArray(q.opts)&&q.opts.length===4&&Number.isInteger(q.ans)&&q.ans>=0&&q.ans<4&&q.exp)){throw Error('formato')}questions=data.map((q,i)=>({id:String(q.id||'import_'+Date.now()+'_'+i),type:q.type==='calc'?'calc':'concept',q:String(q.q),opts:q.opts.map(String),ans:q.ans,exp:String(q.exp)}));persist();renderAdmin();showResult('adminMessage','Importación completada. Se reemplazó el banco local actual.')}catch(e){showResult('adminMessage','No se pudo importar: verifica que sea un JSON exportado con cuatro opciones, respuesta válida y explicación por pregunta.')}event.target.value=''};r.readAsText(f)}
renderAdmin();
</script>
