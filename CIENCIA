<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#123D32">
<meta name="robots" content="noindex">
<title>Panel administrador | RUMBO EDUCA</title>
<style>
:root{--green:#123D32;--green2:#1e5a49;--gold:#b69a5d;--ink:#1d2a25;--muted:#637169;--line:#e2e7e1;--mint:#e8f0eb;--cream:#f6f5f0;--white:#fff;--danger:#b33b3b;--shadow:0 12px 32px rgba(18,61,50,.08)}
*{box-sizing:border-box}
body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink);background:#f7f9f7;line-height:1.5}
a{color:inherit;text-decoration:none}
button,input,textarea,select{font:inherit}
.wrap{width:min(1000px,calc(100% - 32px));margin:auto}
.topbar{background:var(--green);color:#e9f1eb;text-align:center;padding:8px 12px;font-size:.8rem}
.header{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:5}
.nav{min-height:64px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.brand{display:flex;align-items:center;gap:10px;font-weight:850;color:var(--green)}
.brand span.sub{display:block;font-size:.65rem;font-weight:650;color:var(--muted);letter-spacing:.08em}
.btn{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:9px 14px;font-weight:700;font-size:.86rem;border:1px solid transparent;cursor:pointer;background:var(--green);color:#fff}
.btn.ghost{background:#fff;border-color:var(--line);color:var(--green)}
.btn.danger{background:var(--danger);color:#fff}
.btn:hover{opacity:.92}
.gate,.panel{padding:36px 0 48px}
.card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:22px;box-shadow:0 2px 10px rgba(18,61,50,.04)}
.card h1,.card h2{margin:0 0 8px;color:var(--green);font-size:1.35rem}
.card p.lead{margin:0 0 18px;color:var(--muted)}
label{display:block;font-size:.82rem;font-weight:700;margin-bottom:6px;color:var(--green2)}
input[type=password],input[type=text],textarea,select{width:100%;padding:11px 12px;border:1px solid var(--line);border-radius:10px;background:#fff;margin-bottom:12px}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.hint{font-size:.8rem;color:var(--muted);margin-top:-4px;margin-bottom:12px}
.error{color:var(--danger);font-size:.88rem;margin-bottom:10px;display:none}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px;margin-top:18px}
.gcard{border:1px solid var(--line);border-radius:14px;padding:16px;background:#fff;display:flex;flex-direction:column;gap:8px}
.gcard h3{margin:0;font-size:1rem;color:var(--green)}
.gcard p{margin:0;font-size:.84rem;color:var(--muted);flex:1}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.tag{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;padding:3px 8px;border-radius:6px;background:var(--mint);color:var(--green2)}
.tag.off{background:#f0e6e6;color:#8a4040}
.tag.on{background:#e5f5ea;color:#1a6b3c}
.actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:6px}
.actions a,.actions button{font-size:.8rem;padding:7px 11px}
.section-title{margin:28px 0 10px;font-size:1.1rem;color:var(--green);font-weight:800}
.note{background:var(--cream);border:1px solid #ebe6d8;border-radius:12px;padding:14px;font-size:.86rem;color:var(--muted);margin-top:20px}
.toolbar{display:flex;flex-wrap:wrap;gap:10px;justify-content:space-between;align-items:center;margin-bottom:8px}
.status{font-size:.84rem;color:var(--muted)}
footer{padding:20px 0;text-align:center;font-size:.78rem;color:var(--muted)}
.hidden{display:none!important}
table{width:100%;border-collapse:collapse;font-size:.88rem}
th,td{text-align:left;padding:10px 8px;border-bottom:1px solid var(--line)}
th{font-size:.75rem;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}
@media(max-width:560px){.nav .btn.ghost{display:none}}
</style>
</head>
<body>
<div class="topbar">RUMBO EDUCA · Panel administrador · Uso interno</div>
<header class="header">
  <div class="wrap nav">
    <a class="brand" href="../index.html">
      ⚙ RUMBO ADMIN
      <span class="sub">LABORATORIO DE APRENDIZAJE</span>
    </a>
    <div class="row">
      <a class="btn ghost" href="../index.html">← Portada</a>
      <button type="button" class="btn danger hidden" id="btnLogout">Cerrar sesión</button>
    </div>
  </div>
</header>

<main>
  <!-- GATE -->
  <section class="gate" id="gateSection">
    <div class="wrap">
      <div class="card" style="max-width:420px;margin:auto">
        <h1>Acceso administrador</h1>
        <p class="lead">Panel para gestionar guías y acceder a los editores de preguntas de cada recurso.</p>
        <label for="pin">Clave de acceso</label>
        <input type="password" id="pin" placeholder="Ingresa la clave" autocomplete="current-password">
        <p class="hint">Clave por defecto del prototipo: <strong>rumbo2026</strong> (cámbiala en producción).</p>
        <div class="error" id="pinError">Clave incorrecta.</div>
        <button type="button" class="btn" id="btnLogin">Entrar</button>
      </div>
    </div>
  </section>

  <!-- PANEL -->
  <section class="panel hidden" id="panelSection">
    <div class="wrap">
      <div class="toolbar">
        <div>
          <h1 style="margin:0;font-size:1.4rem;color:var(--green)">Panel global</h1>
          <p class="status" id="statusLine">Cargando…</p>
        </div>
        <div class="row">
          <button type="button" class="btn ghost" id="btnExport">Exportar catálogo JSON</button>
          <button type="button" class="btn ghost" id="btnReset">Restablecer estados</button>
        </div>
      </div>

      <div class="card">
        <h2>Tests de orientación</h2>
        <p class="lead" style="margin-bottom:12px">Instrumentos de autoconocimiento y resiliencia.</p>
        <div class="grid" id="testsGrid"></div>
      </div>

      <h2 class="section-title">Guías de química (RUMBO CIENCIAS)</h2>
      <p class="status" style="margin-top:-4px">Cada guía tiene su propio panel de preguntas (sección <code>#admin</code>). Aquí controlas si aparece como publicada en el catálogo.</p>
      <div class="grid" id="guidesGrid"></div>

      <div class="note">
        <strong>Cómo editar preguntas:</strong> entra a “Editor de preguntas” de la guía. Los cambios se guardan en <em>localStorage</em> de este navegador (no se sincronizan entre dispositivos). Usa la opción de exportar JSON dentro de cada guía para respaldar el banco.<br><br>
        <strong>Agregar una guía nueva:</strong> por ahora se hace copiando un HTML a la carpeta <code>ciencias/</code> y registrándola en este panel (campo de abajo). En una versión con servidor se conectará a base de datos.
      </div>

      <div class="card" style="margin-top:18px">
        <h2>Registrar guía nueva (local)</h2>
        <p class="lead">Añade una entrada al catálogo local. Debe existir el archivo HTML en <code>ciencias/</code>.</p>
        <div class="row" style="align-items:flex-end">
          <div style="flex:1;min-width:160px">
            <label for="newId">ID / archivo (sin .html)</label>
            <input type="text" id="newId" placeholder="ej: termoquimica">
          </div>
          <div style="flex:2;min-width:200px">
            <label for="newTitle">Título</label>
            <input type="text" id="newTitle" placeholder="ej: Termoquímica">
          </div>
          <div style="flex:1;min-width:140px">
            <label for="newCat">Categoría</label>
            <select id="newCat">
              <option value="estructura">Estructura</option>
              <option value="materia">Materia</option>
              <option value="reacciones">Reacciones</option>
              <option value="soluciones">Soluciones</option>
              <option value="organica">Orgánica</option>
            </select>
          </div>
          <button type="button" class="btn" id="btnAddGuide">Agregar</button>
        </div>
      </div>

      <div class="card" style="margin-top:18px">
        <h2>Estado del catálogo</h2>
        <table>
          <thead><tr><th>Recurso</th><th>Estado</th><th>Notas</th></tr></thead>
          <tbody id="tableBody"></tbody>
        </table>
      </div>
    </div>
  </section>
</main>

<footer>
  RUMBO EDUCA · Laboratorio de aprendizaje y orientación · OAKTREESKY · Prototipo local
</footer>

<script>
const PIN = 'rumbo2026';
const STORAGE_KEY = 'rumbo_admin_state_v1';
const SESSION_KEY = 'rumbo_admin_session';

const DEFAULT_TESTS = [
  { id: 'resiliencia', title: 'Test de Resiliencia', desc: '90 ítems · 8 dimensiones · plan personal', href: '../resiliencia/', adminHref: '../resiliencia/' },
  { id: 'orientacion', title: 'Orientación Vocacional', desc: 'Exploración de intereses y perfiles', href: '../orientacion/', adminHref: '../orientacion/' }
];

const DEFAULT_GUIDES = [
  { id: 'modelos-atomicos', title: 'Modelos atómicos', cat: 'estructura', file: 'modelos-atomicos.html' },
  { id: 'enlaces-quimicos', title: 'Enlaces químicos', cat: 'estructura', file: 'enlaces-quimicos.html' },
  { id: 'estados-materia', title: 'Estados de agregación', cat: 'materia', file: 'estados-materia.html' },
  { id: 'propiedades-materia', title: 'Propiedades de la materia', cat: 'materia', file: 'propiedades-materia.html' },
  { id: 'balanceo-ecuaciones', title: 'Balanceo de ecuaciones', cat: 'reacciones', file: 'balanceo-ecuaciones.html' },
  { id: 'estequiometria', title: 'Estequiometría', cat: 'reacciones', file: 'estequiometria.html' },
  { id: 'unidades-concentracion', title: 'Unidades de concentración', cat: 'soluciones', file: 'unidades-concentracion.html' },
  { id: 'solubilidad-ciclo-agua', title: 'Curvas de solubilidad', cat: 'soluciones', file: 'solubilidad-ciclo-agua.html' },
  { id: 'propiedades-coligativas', title: 'Propiedades coligativas', cat: 'soluciones', file: 'propiedades-coligativas.html' },
  { id: 'gases-ideales', title: 'Gases ideales', cat: 'soluciones', file: 'gases-ideales.html' },
  { id: 'organica-carbono', title: 'Fundamentos del carbono', cat: 'organica', file: 'organica-carbono.html' },
  { id: 'organica-petroleo', title: 'Orgánica y petróleo', cat: 'organica', file: 'organica-petroleo.html' }
];

function loadState() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) return JSON.parse(raw);
  } catch (e) {}
  return {
    guides: DEFAULT_GUIDES.map(g => ({ ...g, published: true, note: '' })),
    tests: DEFAULT_TESTS.map(t => ({ ...t, published: true, note: '' }))
  };
}

function saveState(state) {
  localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
}

let state = loadState();

function isLoggedIn() {
  return sessionStorage.getItem(SESSION_KEY) === '1';
}

function showPanel(show) {
  document.getElementById('gateSection').classList.toggle('hidden', show);
  document.getElementById('panelSection').classList.toggle('hidden', !show);
  document.getElementById('btnLogout').classList.toggle('hidden', !show);
}

function render() {
  const testsGrid = document.getElementById('testsGrid');
  const guidesGrid = document.getElementById('guidesGrid');
  const tableBody = document.getElementById('tableBody');
  testsGrid.innerHTML = '';
  guidesGrid.innerHTML = '';
  tableBody.innerHTML = '';

  state.tests.forEach((t, i) => {
    testsGrid.appendChild(makeCard(t, 'test', i));
    tableBody.appendChild(makeRow(t.title, t.published, t.note));
  });

  state.guides.forEach((g, i) => {
    guidesGrid.appendChild(makeCard(g, 'guide', i));
    tableBody.appendChild(makeRow(g.title, g.published, g.note));
  });

  const pub = state.guides.filter(g => g.published).length;
  document.getElementById('statusLine').textContent =
    `${state.guides.length} guías · ${pub} publicadas · ${state.tests.length} tests · datos en este navegador`;
}

function makeCard(item, type, index) {
  const el = document.createElement('article');
  el.className = 'gcard';
  const published = item.published !== false;
  const cat = item.cat ? `<span class="tag">${item.cat}</span>` : '';
  const href = type === 'guide' ? `../ciencias/${item.file}` : item.href;
  const adminHref = type === 'guide' ? `../ciencias/${item.file}#admin` : (item.adminHref || href);

  el.innerHTML = `
    <h3>${escapeHtml(item.title)}</h3>
    <p>${escapeHtml(item.desc || 'Guía interactiva de química')}</p>
    <div class="tags">
      ${cat}
      <span class="tag ${published ? 'on' : 'off'}">${published ? 'Publicada' : 'Oculta'}</span>
    </div>
    <div class="actions">
      <a class="btn ghost" href="${href}" target="_blank" rel="noopener">Abrir</a>
      <a class="btn ghost" href="${adminHref}" target="_blank" rel="noopener">Editor de preguntas</a>
      <button type="button" class="btn ghost" data-toggle="${type}-${index}">${published ? 'Ocultar' : 'Publicar'}</button>
    </div>
  `;
  el.querySelector('[data-toggle]').addEventListener('click', () => {
    if (type === 'guide') {
      state.guides[index].published = !state.guides[index].published;
    } else {
      state.tests[index].published = !state.tests[index].published;
    }
    saveState(state);
    render();
  });
  return el;
}

function makeRow(title, published, note) {
  const tr = document.createElement('tr');
  tr.innerHTML = `<td>${escapeHtml(title)}</td><td>${published !== false ? 'Publicada' : 'Oculta'}</td><td>${escapeHtml(note || '—')}</td>`;
  return tr;
}

function escapeHtml(s) {
  return String(s || '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

document.getElementById('btnLogin').addEventListener('click', () => {
  const val = document.getElementById('pin').value.trim();
  if (val === PIN) {
    sessionStorage.setItem(SESSION_KEY, '1');
    document.getElementById('pinError').style.display = 'none';
    showPanel(true);
    render();
  } else {
    document.getElementById('pinError').style.display = 'block';
  }
});

document.getElementById('pin').addEventListener('keydown', e => {
  if (e.key === 'Enter') document.getElementById('btnLogin').click();
});

document.getElementById('btnLogout').addEventListener('click', () => {
  sessionStorage.removeItem(SESSION_KEY);
  showPanel(false);
});

document.getElementById('btnExport').addEventListener('click', () => {
  const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'rumbo-catalogo.json';
  a.click();
  URL.revokeObjectURL(a.href);
});

document.getElementById('btnReset').addEventListener('click', () => {
  if (!confirm('¿Restablecer estados de publicación a los valores por defecto?')) return;
  localStorage.removeItem(STORAGE_KEY);
  state = loadState();
  render();
});

document.getElementById('btnAddGuide').addEventListener('click', () => {
  const id = document.getElementById('newId').value.trim().toLowerCase().replace(/[^a-z0-9-]/g, '-');
  const title = document.getElementById('newTitle').value.trim();
  const cat = document.getElementById('newCat').value;
  if (!id || !title) {
    alert('Completa ID y título.');
    return;
  }
  if (state.guides.some(g => g.id === id)) {
    alert('Ya existe una guía con ese ID.');
    return;
  }
  state.guides.push({
    id,
    title,
    cat,
    file: id + '.html',
    published: false,
    note: 'Registrada localmente — verifica que el archivo exista'
  });
  saveState(state);
  document.getElementById('newId').value = '';
  document.getElementById('newTitle').value = '';
  render();
});

// Init
if (isLoggedIn()) {
  showPanel(true);
  render();
}
</script>
</body>
</html>

