redox:{eq:'KMnO₄ + HCl → KCl + MnCl₂ + H₂O + Cl₂',species:[{f:'KMnO₄',atoms:{K:1,Mn:1,O:4}},{f:'HCl',atoms:{H:1,Cl:1}},{f:'KCl',atoms:{K:1,Cl:1}},{f:'MnCl₂',atoms:{Mn:1,Cl:2}},{f:'H₂O',atoms:{H:2,O:1}},{f:'Cl₂',atoms:{Cl:2}}],answer:[2,16,2,2,8,5],leftCount:2},
