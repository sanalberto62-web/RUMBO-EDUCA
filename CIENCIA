$('algExample').onchange=setupAlg;setupAlg();$('checkAlg').onclick=()=>{const d=algData[$('algExample').value],v=d.names.map((x,i)=>parseInt($('alg_'+i).value)||0),ok=v.every(x=>x>0)&&v.every((x,i)=>x*d.answer[0]===d.answer[i]*v[0]);$('algFeedback').innerHTML=ok?'<p class="feedback">Los coeficientes son proporcionales a la solución mínima: '+v.join(' : ')+'.</p>':'<p class="bad">No coinciden con la proporción mínima. Plantea una igualdad por elemento y resuelve el sistema. Solución mínima: '+d.answer.join(' : ')+'.</p>'};
const original=[
{q:'¿Qué se puede cambiar al balancear una ecuación química?',o:['Los subíndices de las fórmulas para que cuadren los átomos.','Los coeficientes estequiométricos delante de las fórmulas.','La identidad de los reactivos sin indicarlo.','Solo los símbolos de los elementos.'],a:1,exp:'Se ajustan coeficientes. Cambiar subíndices cambia la sustancia y ya no representa la misma reacción.'},
{q:'Balancea la combustión del propano: C₃H₈ + O₂ → CO₂ + H₂O. ¿Qué coeficientes mínimos corresponden?',o:['1, 3, 3, 4','1, 5, 3, 4','2, 7, 6, 8','1, 4, 3, 3'],a:1,exp:'C: 3 CO₂; H: 4 H₂O; entonces O total en productos = 6+4=10, que requiere 5 O₂.'},
{q:'En Zn → Zn²⁺ + 2e⁻, el zinc…',o:['Gana dos electrones y se reduce.','Pierde dos electrones y se oxida.','Actúa como agente oxidante porque acepta electrones.','Mantiene el número de oxidación en cero.'],a:1,exp:'El Zn pasa de 0 a +2 y pierde dos electrones; por ello se oxida y es el agente reductor.'},
{q:'¿Qué afirmación describe correctamente al agente oxidante?',o:['Dona electrones y se oxida.','Acepta electrones y se reduce.','Siempre contiene oxígeno.','No cambia su número de oxidación.'],a:1,exp:'El agente oxidante provoca la oxidación de otra especie al aceptar electrones; él mismo se reduce.'},
{q:'En la reacción Zn + Cu²⁺ → Zn²⁺ + Cu, ¿cuál es el agente reductor?',o:['Cu²⁺, porque gana electrones.','Zn, porque pierde electrones y reduce al Cu²⁺.','Zn²⁺, porque gana electrones.','Cu metálico, porque se oxida.'],a:1,exp:'El Zn dona electrones y se oxida; esos electrones reducen al Cu²⁺ a Cu.'},
{q:'En MnO₄⁻ → Mn²⁺, ¿qué cambio de número de oxidación experimenta Mn?',o:['De +2 a +7; se oxida.','De +7 a +2; se reduce y gana cinco electrones por Mn.','De −7 a +2; pierde nueve electrones.','No cambia.'],a:1,exp:'En MnO₄⁻, Mn es +7; en Mn²⁺ es +2. La disminución de cinco unidades corresponde formalmente a ganar cinco electrones.'},
{q:'¿Cuál es la ecuación balanceada de formación del óxido de hierro(III)?',o:['2 Fe + O₂ → Fe₂O₃','4 Fe + 3 O₂ → 2 Fe₂O₃','3 Fe + 2 O₂ → Fe₃O₄','2 Fe + 3 O₂ → 2 FeO₃'],a:1,exp:'4 Fe + 3 O₂ → 2 Fe₂O₃ conserva 4 Fe y 6 O en ambos lados.'},
{q:'En el método algebraico, ¿por qué se fija una variable o se elige una escala?',o:['Porque las fórmulas no tienen átomos.','Porque las ecuaciones de conservación suelen determinar proporciones y admiten múltiplos de la misma solución.','Para permitir que desaparezcan elementos.','Para evitar comprobar la ecuación.'],a:1,exp:'El sistema homogéneo determina relaciones entre coeficientes; las soluciones proporcionales representan la misma ecuación y se escoge la menor solución entera positiva.'},
{q:'En H₂O₂, el oxígeno tiene número de oxidación −1. En 2 H₂O₂ → 2 H₂O + O₂, ¿qué ocurre?',o:['Todo el oxígeno solo se reduce.','Todo el oxígeno solo se oxida.','Parte del oxígeno se reduce a −2 y parte se oxida a 0.','El oxígeno conserva siempre −1.'],a:2,exp:'Es una desproporción: el oxígeno de una parte del peróxido pasa de −1 a −2 y el de otra parte de −1 a 0.'},
{q:'¿Cuál es la ecuación balanceada de la síntesis de amoníaco?',o:['N₂ + H₂ → NH₃','N₂ + 3 H₂ → 2 NH₃','2 N₂ + H₂ → 2 NH₃','N₂ + 2 H₂ → NH₃'],a:1,exp:'Hay 2 átomos de N y 6 de H a ambos lados en N₂ + 3 H₂ → 2 NH₃.'},
{q:'En medio ácido, la semirreacción MnO₄⁻ → Mn²⁺ se balancea con…',o:['4 OH⁻ y 2 H₂ únicamente.','8 H⁺, 4 H₂O y 5 electrones en el lado adecuado.','5 oxígenos libres.','Solo electrones, sin ajustar O ni H.'],a:1,exp:'La semirreacción correcta es MnO₄⁻ + 8 H⁺ + 5 e⁻ → Mn²⁺ + 4 H₂O.'},
{q:'¿Qué verificación es necesaria en una ecuación iónica redox balanceada?',o:['Solo contar el elemento más pesado.','Conservar todos los átomos y la carga total, además de igualar electrones en las semirreacciones.','Comprobar únicamente la masa de reactivos.','Asegurar que haya el mismo número de moléculas en cada lado.'],a:1,exp:'En una ecuación iónica, se conserva cada elemento y la carga total; el número de electrones perdidos y ganados debe coincidir.'},
{q:'Balancea: KMnO₄ + HCl → KCl + MnCl₂ + H₂O + Cl₂. ¿Cuál conjunto mínimo de coeficientes es correcto?',o:['1, 8, 1, 1, 4, 2','2, 16, 2, 2, 8, 5','2, 14, 2, 2, 7, 5','1, 16, 1, 1, 8, 5'],a:1,exp:'La ecuación balanceada es 2 KMnO₄ + 16 HCl → 2 KCl + 2 MnCl₂ + 8 H₂O + 5 Cl₂.'},
{q:'En la reacción anterior, el Cl⁻ de HCl que termina en Cl₂…',o:['Se reduce de −1 a −2 y es oxidante.','Se oxida de −1 a 0 y actúa como reductor.','Permanece siempre en −1.','Gana un electrón por átomo.'],a:1,exp:'El cloruro pierde electrones al formar Cl₂: −1 → 0. Por eso el Cl⁻ es la especie reductora que se oxida.'},
{q:'¿Qué es un error conceptual en el balanceo por tanteo?',o:['Comprobar todos los elementos al final.','Dejar H y O para el final cuando convenga.','Cambiar H₂O por H₂O₂ para corregir la cuenta.','Reducir coeficientes a enteros mínimos.'],a:2,exp:'Cambiar una fórmula altera la identidad de la sustancia. Se deben modificar coeficientes, no subíndices.'},
{q:'En Fe²⁺ → Fe³⁺, el hierro…',o:['Gana un electrón y se reduce.','Pierde un electrón y se oxida; Fe²⁺ actúa como agente reductor.','Actúa como agente oxidante porque su carga aumenta.','No experimenta cambio redox.'],a:1,exp:'El número de oxidación aumenta de +2 a +3; formalmente pierde un electrón y se oxida.'},
{q:'¿Cuál es la ecuación balanceada de descomposición del clorato de potasio?',o:['KClO₃ → KCl + O₂','2 KClO₃ → 2 KCl + 3 O₂','2 KClO₃ → K₂Cl₂ + O₂','KClO₃ → K + Cl + O₃'],a:1,exp:'2 KClO₃ → 2 KCl + 3 O₂ conserva K=2, Cl=2 y O=6.'},
