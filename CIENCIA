function showTab(id){document.querySelectorAll('.panel').forEach(p=>p.classList.toggle('active',p.id===id));document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('active',b.dataset.tab===id));if(id==='periodica')renderPeriodic();if(id==='admin')renderAdmin();window.scrollTo({top:0,behavior:'smooth'});}
