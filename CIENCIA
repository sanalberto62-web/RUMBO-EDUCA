const originalQuestions=[
{q:'¿Qué diferencia fundamental separa la propuesta atomista de Demócrito de la teoría atómica de Dalton?',o:['Demócrito presentó una teoría basada en espectros; Dalton, en órbitas cuantizadas.','La propuesta griega fue filosófica; Dalton la formuló en el marco de leyes químicas cuantitativas.','Demócrito descubrió el electrón; Dalton el neutrón.','No hay diferencias: ambas se basaron en los mismos experimentos.'],a:1,exp:'El atomismo griego fue una propuesta filosófica sin contrastación experimental moderna. Dalton articuló su teoría con leyes de composición química y masas relativas.'},
{q:'En el experimento de rayos catódicos, ¿qué resultado apoyó la existencia de electrones?',o:['El haz siempre atravesaba una lámina de oro sin desviarse.','Se observó una radiación neutra que expulsaba protones de parafina.','El haz se desviaba en campos eléctricos y magnéticos como carga negativa.','El hidrógeno producía líneas espectrales discretas.'],a:2,exp:'La desviación de los rayos catódicos permitió a Thomson inferir partículas negativas presentes en la materia y estimar su relación carga/masa.'},
{q:'¿Cuál fue la observación decisiva en la dispersión de partículas alfa por una lámina de oro?',o:['Todas las partículas rebotaron.','La mayoría pasó casi recta, pero unas pocas se desviaron a ángulos grandes.','El oro emitió electrones al calentarse.','La lámina se convirtió en un gas.'],a:1,exp:'El patrón de dispersión llevó a proponer que la carga positiva y gran parte de la masa estaban concentradas en un núcleo muy pequeño.'},
{q:'¿Por qué los grandes ángulos de dispersión resultaron problemáticos para el modelo de Thomson?',o:['Porque una carga positiva distribuida no generaba una región concentrada capaz de producir desviaciones tan intensas.','Porque el modelo de Thomson no contenía electrones.','Porque las partículas alfa no tienen carga.','Porque la lámina de oro era demasiado gruesa para cualquier experimento.'],a:0,exp:'Una desviación muy grande requiere una interacción intensa en una región pequeña; eso favoreció el modelo nuclear.'},
{q:'¿Qué explicaba especialmente bien el modelo de Bohr?',o:['Todos los espectros de todos los elementos con muchos electrones.','La composición de quarks del protón.','Las líneas espectrales del átomo de hidrógeno mediante transiciones entre niveles de energía.','La conservación de la masa en cualquier proceso nuclear.'],a:2,exp:'Bohr cuantizó los niveles de energía y explicó las frecuencias características del hidrógeno.'},
{q:'¿Qué conclusión se desprende de que el espectro del hidrógeno tenga líneas discretas?',o:['El átomo solo puede emitir luz blanca.','Los intercambios de energía entre estados atómicos ocurren en cantidades definidas.','El electrón tiene una trayectoria clásica medible en todo instante.','El núcleo está formado únicamente por electrones.'],a:1,exp:'Las líneas espectrales corresponden a fotones cuyas energías igualan diferencias entre estados permitidos.'},
{q:'¿Qué significa “orbital” en el modelo cuántico?',o:['Una órbita circular por la que el electrón viaja como un planeta.','Una región física vacía que contiene al electrón inmóvil.','Un estado cuántico descrito matemáticamente que permite calcular probabilidades de resultados de medición.','Una trayectoria que se conoce exactamente si el microscopio es suficientemente potente.'],a:2,exp:'Los orbitales no son trayectorias planetarias; representan estados cuánticos y distribuciones de probabilidad.'},
{q:'¿Cómo se identificó el neutrón en el trabajo de Chadwick?',o:['Pesando directamente un neutrón aislado en una balanza.','Analizando una radiación penetrante producida al bombardear berilio y los protones expulsados de parafina.','Observando el movimiento de planetas.','Separando líneas del espectro visible del helio.'],a:1,exp:'Chadwick estudió la radiación producida por berilio bombardeado con partículas alfa y la transferencia de energía a protones.'},
{q:'Un átomo tiene 11 protones, 12 neutrones y 10 electrones. ¿Cuál es la descripción correcta?',o:['Z=12, A=23 y carga −1.','Z=11, A=23 y carga +1.','Z=23, A=11 y carga 0.','Z=10, A=22 y carga +2.'],a:1,exp:'El número atómico Z es el número de protones (11); el número másico A=p+n=23; la carga neta es p−e=+1.'},
{q:'¿Cuál afirmación sobre isótopos es correcta?',o:['Tienen el mismo número de protones y distinto número de neutrones.','Tienen diferente número de protones, pero siempre idéntica masa.','Se diferencian exclusivamente por el número de electrones.','Son átomos de elementos diferentes con el mismo símbolo.'],a:0,exp:'Los isótopos son átomos del mismo elemento (igual Z) con diferente número de neutrones.'},
{q:'¿Qué muestra la difracción de electrones en cristales?',o:['Que los electrones solo pueden ser ondas clásicas.','Que los electrones muestran comportamiento ondulatorio en condiciones apropiadas.','Que los electrones no tienen carga.','Que los protones están dentro de orbitales electrónicos.'],a:1,exp:'Los máximos de difracción respaldaron la hipótesis de de Broglie sobre las propiedades ondulatorias de la materia.'},
{q:'¿Cuál es una limitación histórica importante del modelo de Dalton?',o:['No podía explicar que la materia tuviera masa.','Consideraba indivisibles los átomos y no incluía partículas subatómicas ni isótopos.','Afirmaba que los electrones estaban en orbitales.','Incluía quarks y gluones.'],a:1,exp:'El modelo de Dalton fue muy útil en química, pero descubrimientos posteriores mostraron que los átomos tienen estructura interna y variedades isotópicas.'},
{q:'En un sistema químico cerrado, la masa se conserva en una reacción ordinaria. ¿Qué interpretación es más adecuada?',o:['Los átomos se destruyen y aparecen de nuevo sin regla alguna.','Los átomos se reorganizan en los productos, conservándose la masa total dentro de la precisión experimental.','La masa siempre desaparece en forma de luz visible.','Esto prueba por sí solo el modelo de Bohr.'],a:1,exp:'La conservación de la masa en reacciones químicas fue una base de la química cuantitativa, aunque no demuestra por sí sola todos los detalles de la estructura atómica.'},
{q:'¿Por qué el modelo de Rutherford necesitó una ampliación?',o:['Porque negó la existencia de cualquier núcleo.','Porque no explicaba por la física clásica la estabilidad del átomo ni los espectros discretos.','Porque no podía explicar que el oro fuera un metal.','Porque predijo correctamente todos los enlaces químicos.'],a:1,exp:'El modelo nuclear resolvió la dispersión alfa, pero necesitó nuevas ideas para explicar la estabilidad y los espectros atómicos.'},
{q:'¿Qué se infiere de los experimentos de dispersión profunda de electrones sobre protones?',o:['El protón es una esfera homogénea sin estructura.','Los protones tienen constituyentes internos compatibles con quarks.','El átomo no tiene núcleo.','Los electrones están formados por moléculas de hidrógeno.'],a:1,exp:'A altas energías, la dispersión reveló estructura interna del protón, interpretada en el marco moderno en términos de quarks y gluones.'},
{q:'¿Cuál es la diferencia entre observación e inferencia en el experimento de la lámina de oro?',o:['La observación fue que existía un núcleo; la inferencia fue contar partículas.','La observación fue registrar destellos y ángulos; la inferencia fue proponer un núcleo pequeño y positivo.','Son exactamente lo mismo.','No hubo observaciones, solo una idea filosófica.'],a:1,exp:'Se detectaron partículas dispersadas en distintos ángulos; la estructura nuclear se dedujo al comparar esos datos con las predicciones de los modelos.'},
{q:'¿Qué describe mejor el principio de incertidumbre de Heisenberg?',o:['Toda medición escolar tiene errores por descuido.','Con mejores microscopios siempre se obtienen simultáneamente valores exactos de posición y momento.','Hay límites fundamentales para la precisión conjunta de ciertos pares de observables, como posición y momento.','Los electrones no existen.'],a:2,exp:'La incertidumbre cuántica es una característica fundamental de la teoría, no solo una limitación tecnológica.'},
{q:'¿Qué relación entre protones, neutrones y número atómico es correcta?',o:['Z = protones + neutrones.','Z = número de electrones en cualquier ion.','Z = número de protones; A = protones + neutrones.','A = protones − electrones.'],a:2,exp:'El número atómico define la identidad del elemento y es igual al número de protones; el número másico cuenta nucleones.'},
{q:'¿Qué afirmación refleja mejor la naturaleza de los modelos científicos?',o:['Un modelo aceptado nunca se modifica.','Un experimento confirma automáticamente cada parte de un modelo.','Los modelos explican un conjunto de datos dentro de ciertos límites y pueden revisarse ante nuevas evidencias.','Un modelo solo es científico si puede observarse directamente como una fotografía.'],a:2,exp:'Los modelos se juzgan por su capacidad explicativa, predictiva y su contraste con observaciones; pueden ampliarse o sustituirse al aparecer nuevas evidencias.'},
{q:'¿Cuál afirmación sobre la estructura atómica actual es más precisa?',o:['Los electrones recorren siempre órbitas circulares como planetas.','Protones y neutrones son partículas compuestas por quarks; los electrones se describen mediante estados cuánticos.','El átomo es una esfera maciza e indivisible.','Los orbitales son pequeños recipientes sólidos.'],a:1,exp:'La descripción actual combina estructura nuclear, quarks y gluones en nucleones, y estados cuánticos para los electrones.'}
];
let bank=JSON.parse(localStorage.getItem('atomGuideBank')||'null')||JSON.parse(JSON.stringify(originalQuestions));let quizSet=[];
function saveBank(){localStorage.setItem('atomGuideBank',JSON.stringify(bank))}
function startQuiz(){const n=Math.min(+$('nQuestions').value,bank.length);quizSet=[...bank].sort(()=>Math.random()-.5).slice(0,n);$('quizResult').innerHTML='';$('quiz').innerHTML='';quizSet.forEach((q,i)=>{const d=document.createElement('div');d.className='quiz-q';d.innerHTML=`<b>${i+1}. ${q.q}</b><div>${q.o.map((o,j)=>`<label class="option"><input type="radio" name="q${i}" value="${j}"> ${String.fromCharCode(65+j)}. ${o}</label>`).join('')}</div><div id="fb${i}" class="small"></div>`;$('quiz').appendChild(d)});const btn=document.createElement('button');btn.className='btn primary';btn.textContent='Calificar evaluación';btn.onclick=gradeQuiz;$('quiz').appendChild(btn)}
function gradeQuiz(){let score=0;quizSet.forEach((q,i)=>{const chosen=document.querySelector(`input[name="q${i}"]:checked`);const fb=$('fb'+i);if(chosen&&+chosen.value===q.a){score++;fb.className='feedback';fb.textContent='Correcto. '+q.exp}else{fb.className='bad';fb.textContent=`Respuesta correcta: ${String.fromCharCode(65+q.a)}. ${q.o[q.a]} Explicación: ${q.exp}`}});const pct=Math.round(score/quizSet.length*100);$('quizResult').innerHTML=`<p class="score">Resultado: ${score}/${quizSet.length} · ${pct}%</p><p>${pct>=90?'Dominio sobresaliente.':pct>=75?'Buen desempeño; revisa las explicaciones de los errores.':pct>=60?'Comprensión parcial: vuelve a estudiar los experimentos y las limitaciones de cada modelo.':'Necesitas repasar la cronología, las evidencias y la diferencia entre observación e inferencia.'}</p>`}
$('startQuiz').onclick=startQuiz;
function renderAdmin(){const c=$('adminList');c.innerHTML='';bank.forEach((q,i)=>{const d=document.createElement('details');const s=document.createElement('summary');s.textContent=(i+1)+'. '+q.q.slice(0,85);d.appendChild(s);const p=document.createElement('p');p.className='small';p.textContent='Respuesta correcta: '+String.fromCharCode(65+q.a)+'. '+q.o[q.a];d.appendChild(p);const edit=document.createElement('button');edit.className='btn';edit.textContent='Editar';edit.onclick=()=>loadQuestion(i);const del=document.createElement('button');del.className='btn';del.textContent='Eliminar';del.onclick=()=>{if(confirm('¿Eliminar esta pregunta?')){bank.splice(i,1);saveBank();renderAdmin()}};d.append(edit,del);c.appendChild(d)})}
function loadQuestion(i){const q=bank[i];$('editId').value=i;$('editQ').value=q.q;q.o.forEach((v,j)=>$('opt'+j).value=v);$('editA').value=q.a;$('editExp').value=q.exp}
function clearEditor(){$('editId').value='';$('editQ').value='';for(let j=0;j<4;j++)$('opt'+j).value='';$('editA').value=0;$('editExp').value=''}
$('saveQ').onclick=()=>{const q={q:$('editQ').value.trim(),o:[0,1,2,3].map(j=>$('opt'+j).value.trim()),a:+$('editA').value,exp:$('editExp').value.trim()};if(!q.q||q.o.some(x=>!x)||!q.exp||q.a<0||q.a>3){$('adminStatus').textContent='Completa el enunciado, las cuatro opciones, la respuesta correcta y la explicación.';return}const i=$('editId').value;if(i==='')bank.push(q);else bank[+i]=q;saveBank();renderAdmin();clearEditor();$('adminStatus').textContent='Pregunta guardada correctamente en este navegador.'};
$('newQ').onclick=clearEditor;
$('exportJson').onclick=()=>{const blob=new Blob([JSON.stringify(bank,null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download='banco_modelos_atomicos.json';a.click();URL.revokeObjectURL(url);$('adminStatus').textContent='Banco exportado.'};
$('importFile').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{const data=JSON.parse(await f.text());if(!Array.isArray(data)||!data.every(q=>q.q&&Array.isArray(q.o)&&q.o.length===4&&Number.isInteger(q.a)&&q.a>=0&&q.a<4&&q.exp))throw new Error('Formato no válido');bank=data;saveBank();renderAdmin();$('adminStatus').textContent='Banco importado correctamente.'}catch(err){$('adminStatus').textContent='No se pudo importar: revisa que el JSON tenga el formato esperado.'}e.target.value=''};
$('resetBank').onclick=()=>{if(confirm('¿Restaurar las preguntas originales? Se reemplazará el banco guardado localmente.')){bank=JSON.parse(JSON.stringify(originalQuestions));saveBank();renderAdmin();$('adminStatus').textContent='Banco original restaurado.'}};
