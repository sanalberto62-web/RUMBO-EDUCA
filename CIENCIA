function setupCoefficientInputs(selectId,containerId,eqId){const key=$(selectId).value,p=practice[key];$(eqId).textContent=p.eq;const c=$(containerId);c.innerHTML='';p.species.forEach((s,i)=>{const label=document.createElement('label');label.textContent=s.f+' ';const input=document.createElement('input');input.type='number';input.min='1';input.max='100';input.value='1';input.id=containerId+'_'+i;input.style.width='70px';label.appendChild(input);c.appendChild(label)})}
function verifyBalance(key,values){const p=practice[key],counts={};p.species.forEach((s,i)=>Object.entries(s.atoms).forEach(([el,n])=>{counts[el]??={left:0,right:0};counts[el][i<p.species.length/2?'left':'right']+=n*values[i]}));return counts}
function checkPractice(){const key=$('practiceSelect').value,p=practice[key],vals=p.species.map((s,i)=>Math.max(0,parseInt($( 'practiceInputs_'+i).value)||0));const count={};p.species.forEach((s,i)=>Object.entries(s.atoms).forEach(([el,n])=>{count[el]??=[0,0];count[el][i<p.leftCount?0:1]+=n*vals[i]}));const elements=[...new Set(p.species.flatMap(s=>Object.keys(s.atoms)))];let balanced=true;let html='<table class="atomtable"><thead><tr><th>Elemento</th><th>Reactivos</th><th>Productos</th><th>Estado</th></tr></thead><tbody>';elements.forEach(el=>{const n=count[el]||[0,0],ok=n[0]===n[1];if(!ok)balanced=false;html+=`<tr><td>${el}</td><td>${n[0]}</td><td>${n[1]}</td><td class="${ok?'good':'bad'}">${ok?'Conservado':'No coincide'}</td></tr>`});html+='</tbody></table>';const expected=p.answer.every((n,i)=>n===vals[i]);$('practiceFeedback').innerHTML=balanced&&expected?'<p class="feedback">¡Correcto! La ecuación está balanceada con los coeficientes enteros mínimos.</p>':balanced?'<p class="warn">La conservación se cumple con esos coeficientes, pero revisa si son los menores enteros posibles o si todos los valores son positivos.</p>':'<p class="bad">Todavía no está balanceada. Revisa los elementos que no coinciden en la tabla.</p>';if(balanced&&!expected){const gcd=(a,b)=>b?gcd(b,a%b):a;let g=vals.reduce((a,b)=>gcd(a,b));if(g>1)$('practiceFeedback').innerHTML+=`<p>Los coeficientes pueden reducirse dividiéndolos por ${g}, si la ecuación continúa siendo entera.</p>`}$('practiceAtoms').innerHTML=html}
$('practiceSelect').onchange=()=>{setupCoefficientInputs('practiceSelect','practiceInputs','practiceEquation');$('practiceFeedback').innerHTML='';$('practiceAtoms').innerHTML=''};$('verifyPractice').onclick=checkPractice;setupCoefficientInputs('practiceSelect','practiceInputs','practiceEquation');
const algData={water:{eq:'a H₂ + b O₂ → c H₂O',names:['H₂','O₂','H₂O'],answer:[2,1,2],leftCount:2},propane:{eq:'a C₃H₈ + b O₂ → c CO₂ + d H₂O',names:['C₃H₈','O₂','CO₂','H₂O'],answer:[1,5,3,4],leftCount:2},ethane:{eq:'a C₂H₆ + b O₂ → c CO₂ + d H₂O',names:['C₂H₆','O₂','CO₂','H₂O'],answer:[2,7,4,6]},alum:{eq:'a Al + b O₂ → c Al₂O₃',names:['Al','O₂','Al₂O₃'],answer:[4,3,2],leftCount:2},iron:{eq:'a Fe + b O₂ → c Fe₂O₃',names:['Fe','O₂','Fe₂O₃'],answer:[4,3,2],leftCount:2}};
