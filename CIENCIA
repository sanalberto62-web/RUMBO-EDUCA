const practice={
water:{eq:'H₂ + O₂ → H₂O',species:[{f:'H₂',atoms:{H:2}},{f:'O₂',atoms:{O:2}},{f:'H₂O',atoms:{H:2,O:1}}],answer:[2,1,2],leftCount:2},
