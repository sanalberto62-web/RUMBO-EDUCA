perm:{eq:'KMnO₄ + FeSO₄ + H₂SO₄ → K₂SO₄ + MnSO₄ + Fe₂(SO₄)₃ + H₂O',species:[{f:'KMnO₄',atoms:{K:1,Mn:1,O:4}},{f:'FeSO₄',atoms:{Fe:1,S:1,O:4}},{f:'H₂SO₄',atoms:{H:2,S:1,O:4}},{f:'K₂SO₄',atoms:{K:2,S:1,O:4}},{f:'MnSO₄',atoms:{Mn:1,S:1,O:4}},{f:'Fe₂(SO₄)₃',atoms:{Fe:2,S:3,O:12}},{f:'H₂O',atoms:{H:2,O:1}}],answer:[2,10,8,1,2,5,8],leftCount:3}
