<script>
const $=id=>document.getElementById(id);
document.querySelectorAll('nav button').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('nav button').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));b.classList.add('active');$(b.dataset.tab).classList.add('active');if(b.dataset.tab==='admin')renderAdmin()}));
function fmt(x,n=5){return Number(x).toLocaleString('es-CO',{maximumFractionDigits:n})}
function convertTempValue(v,s){if(s==='C')return {C:v,K:v+273.15,F:v*9/5+32};if(s==='K')return {C:v-273.15,K:v,F:(v-273.15)*9/5+32};return {C:(v-32)*5/9,K:(v-32)*5/9+273.15,F:v}}
$('convertTemp').addEventListener('click',()=>{let v=Number($('tempValue').value),s=$('tempScale').value;if(!Number.isFinite(v)){ $('tempResult').textContent='Introduce un valor válido.';return}let x=convertTempValue(v,s);if(x.K<0){$('tempResult').textContent='La temperatura es inferior al cero absoluto; revisa el dato.';return}$('tempResult').textContent=`${fmt(x.C,4)} °C = ${fmt(x.K,4)} K = ${fmt(x.F,4)} °F`});
const unitDefs={
pressure:{Pa:1,kPa:1000,MPa:1e6,bar:100000,atm:101325,mmHg:101325/760,torr:101325/760,psi:6894.757293},
volume:{m3:1000,L:1,mL:0.001,cm3:0.001,dm3:1,ft3:28.3168466},
density:{'kg/m³':1,'g/L':1,'g/mL':1000,'kg/L':1000,'mg/mL':1,'g/cm³':1000},
temperature:{'°C':'C',K:'K','°F':'F'}
};
function populateUnits(){let type=$('convType').value,units=Object.keys(unitDefs[type]);$('convFrom').innerHTML=units.map(u=>`<option>${u}</option>`).join('');$('convTo').innerHTML=units.map(u=>`<option>${u}</option>`).join('');if(type==='pressure'){$('convFrom').value='atm';$('convTo').value='kPa'}else if(type==='volume'){$('convFrom').value='L';$('convTo').value='mL'}else if(type==='density'){$('convFrom').value='g/L';$('convTo').value='kg/m³'}else{$('convFrom').value='°C';$('convTo').value='K'}}
$('convType').addEventListener('change',populateUnits);populateUnits();
$('doConvert').addEventListener('click',()=>{let type=$('convType').value,v=Number($('convValue').value),from=$('convFrom').value,to=$('convTo').value;if(!Number.isFinite(v)){$('convResult').textContent='Introduce un valor numérico.';return}let out;if(type==='temperature'){let x=convertTempValue(v,unitDefs.temperature[from]);out=x[unitDefs.temperature[to]];if(x.K<0){$('convResult').textContent='Temperatura por debajo del cero absoluto.';return}}else out=v*unitDefs[type][from]/unitDefs[type][to];$('convResult').textContent=`${fmt(v,8)} ${from} = ${fmt(out,8)} ${to}`});
