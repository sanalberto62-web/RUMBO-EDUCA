let questions=JSON.parse(localStorage.getItem('qorg_questions')||'null')||initialQuestions.map((q,i)=>({...q,id:i+1}));let quizState={items:[],answers:{},submitted:false};
function persist(){localStorage.setItem('qorg_questions',JSON.stringify(questions))}
function startQuiz(shuffle){quizState={items:questions.map((q,i)=>({...q,_i:i})),answers:{},submitted:false};if(shuffle)quizState.items.sort(()=>Math.random()-.5);$('quizSummary').classList.add('hide');renderQuiz()}
function renderQuiz(){let area=$('quizArea');$('quizCount').textContent=`${quizState.items.length} preguntas`;if(!quizState.items.length){area.innerHTML='<div class="result">No hay preguntas en el banco.</div>';return}area.innerHTML=quizState.items.map((q,i)=>`<div class="qbox" id="qbox${i}"><b>${i+1}. ${esc(q.q)}</b>${q.a.map((a,j)=>`<button class="option ${quizState.answers[i]===j?'selected':''}" ${quizState.submitted?'disabled':''} onclick="answerQuestion(${i},${j})">${String.fromCharCode(65+j)}. ${esc(a)}</button>`).join('')}${quizState.submitted?`<div class="feedback">${quizState.answers[i]===q.c?'<span class="ok"><b>Correcto.</b></span>':'<span class="bad"><b>Respuesta correcta: '+String.fromCharCode(65+q.c)+'.</b></span>'} ${esc(q.e)}</div>`:''}</div>`).join('')+(!quizState.submitted?'<button class="btn" onclick="submitQuiz()">Calificar evaluación</button>':'<button class="btn secondary" onclick="startQuiz(false)">Intentar de nuevo</button>')}
function answerQuestion(i,j){if(quizState.submitted)return;quizState.answers[i]=j;renderQuiz()}
function submitQuiz(){quizState.submitted=true;let score=quizState.items.reduce((s,q,i)=>s+(quizState.answers[i]===q.c?1:0),0);renderQuiz();let r=$('quizSummary');r.classList.remove('hide');r.innerHTML=`<h3>Resultado: ${score}/${quizState.items.length} (${Math.round(score/quizState.items.length*100)}%)</h3><p>${score/quizState.items.length>=.85?'Dominio sólido de los fundamentos.':score/quizState.items.length>=.6?'Buen avance: revisa las explicaciones de las preguntas falladas.':'Conviene repasar historia, configuración electrónica, hibridación y clasificación de carbonos antes de repetir.'}</p>`;r.scrollIntoView({behavior:'smooth',block:'center'})}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function renderAdmin(){let box=$('adminList');box.innerHTML=questions.map((q,i)=>`<div class="qbox"><b>${i+1}. ${esc(q.q)}</b><div class="controls"><button class="btn secondary" onclick="editQuestion(${i})">Editar</button><button class="btn danger" onclick="deleteQuestion(${i})">Eliminar</button></div></div>`).join('')||'<p>No hay preguntas guardadas.</p>'}
function clearQuestionForm(){['editId','newQuestion','optA','optB','optC','optD','newExplanation'].forEach(id=>$(id).value='');$('correctOpt').value='0'}
function saveQuestion(){let q=$('newQuestion').value.trim(),a=[$('optA').value.trim(),$('optB').value.trim(),$('optC').value.trim(),$('optD').value.trim()],c=Number($('correctOpt').value),e=$('newExplanation').value.trim();if(!q||a.some(x=>!x)||!e){alert('Completa el enunciado, las cuatro opciones y la explicación.');return}let id=$('editId').value;if(id!==''&&questions[Number(id)]){questions[Number(id)]={...questions[Number(id)],q,a,c,e}}else{questions.push({id:Date.now(),q,a,c,e})}persist();renderAdmin();clearQuestionForm();$('adminMsg').classList.remove('hide');$('adminMsg').textContent='Pregunta guardada correctamente en este navegador.'}
function editQuestion(i){let q=questions[i];$('editId').value=i;$('newQuestion').value=q.q;q.a.forEach((a,j)=>$('opt'+String.fromCharCode(65+j)).value=a);$('correctOpt').value=q.c;$('newExplanation').value=q.e;document.querySelector('.section.active').scrollIntoView({behavior:'smooth',block:'start'})}
function deleteQuestion(i){if(confirm('¿Eliminar esta pregunta del banco guardado?')){questions.splice(i,1);persist();renderAdmin()}}
function exportQuestions(){let data=JSON.stringify(questions,null,2);$('jsonOutput').classList.remove('hide');$('jsonOutput').value=data;$('jsonOutput').focus();$('jsonOutput').select();try{navigator.clipboard?.writeText(data)}catch(e){}}
function importQuestions(ev){let f=ev.target.files[0];if(!f)return;let reader=new FileReader();reader.onload=()=>{try{let data=JSON.parse(reader.result);if(!Array.isArray(data)||data.some(q=>!q.q||!Array.isArray(q.a)||q.a.length!==4||!Number.isInteger(q.c)||q.c<0||q.c>3||!q.e))throw Error('Formato no válido');questions=data.map((q,i)=>({...q,id:q.id||Date.now()+i}));persist();renderAdmin();alert('Banco importado correctamente.')}catch(e){alert('No se pudo importar. Verifica que el JSON tenga preguntas con q, a (4 opciones), c (0–3) y e.')}};reader.readAsText(f);ev.target.value=''}
function resetQuestions(){if(confirm('¿Restaurar las preguntas iniciales? Se reemplazará el banco actual guardado.')){questions=initialQuestions.map((q,i)=>({...q,id:i+1}));persist();renderAdmin();clearQuestionForm()}}
