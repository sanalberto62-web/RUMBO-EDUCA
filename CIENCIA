<script>
const particleBox=document.getElementById('particleBox');
const descriptions={solid:'En un sólido, las partículas están próximas y ordenadas; vibran alrededor de posiciones relativamente fijas.',liquid:'En un líquido, las partículas siguen próximas, pero pueden cambiar de posición y deslizarse unas junto a otras.',gas:'En un gas, las partículas están muy separadas y se distribuyen por todo el recipiente.',plasma:'El plasma contiene partículas cargadas. El color de este esquema solo las distingue visualmente; no representa una escala física.'};
function drawParticles(){const s=document.getElementById('statePick').value;particleBox.innerHTML='';let pts=[];if(s==='solid'){for(let r=0;r<5;r++)for(let c=0;c<8;c++)pts.push([9+c*11,15+r*17])}else if(s==='liquid'){for(let i=0;i<40;i++)pts.push([4+Math.random()*91,15+Math.random()*70])}else{for(let i=0;i<25;i++)pts.push([3+Math.random()*94,4+Math.random()*88])}pts.forEach((p,i)=>{let d=document.createElement('span');d.className='dot';d.style.left=p[0]+'%';d.style.top=p[1]+'%';if(s==='plasma'){d.style.background=i%2?'#ffbd69':'#a8f0d2';d.style.boxShadow=i%2?'0 0 12px #ffbd69':'0 0 12px #a8f0d2'}particleBox.appendChild(d)});document.getElementById('particleDesc').textContent=descriptions[s]}
document.getElementById('statePick').addEventListener('change',drawParticles);document.getElementById('particleBtn').addEventListener('click',drawParticles);drawParticles();
const changes={fusion:['Sólido → líquido','Absorbe energía. Ejemplo: hielo que se derrite.'],solidificacion:['Líquido → sólido','Libera energía. Ejemplo: agua que se congela.'],vaporizacion:['Líquido → gas','Absorbe energía. Puede ocurrir por evaporación o ebullición.'],condensacion:['Gas → líquido','Libera energía. Ejemplo: vapor que forma gotas en una superficie fría.'],sublimacion:['Sólido → gas','Absorbe energía. Ejemplo: dióxido de carbono sólido que sublima a presión atmosférica.'],deposicion:['Gas → sólido','Libera energía. Ejemplo: vapor que forma escarcha.']};
document.getElementById('changeBtn').addEventListener('click',()=>{let c=changes[document.getElementById('changePick').value];document.getElementById('changeResult').innerHTML='<strong>'+c[0]+'</strong><br>'+c[1]});
document.getElementById('appBtn').addEventListener('click',()=>{const v=document.getElementById('appPick').value;const r=document.getElementById('appResult');r.textContent=v==='a'?'Correcto. Aumentar la temperatura modifica la presión de vapor y el equilibrio entre las fases.':v?'No es correcto. Revisa la relación entre temperatura, presión de vapor y equilibrio líquido-vapor.':'Selecciona una opción.';r.className='result '+(v==='a'?'correct':'incorrect')});
function drawHeating(){const c=document.getElementById('heatingCanvas'),ctx=c.getContext('2d'),w=c.width,h=c.height;ctx.clearRect(0,0,w,h);ctx.strokeStyle='#285342';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(85,25);ctx.lineTo(85,h-65);ctx.lineTo(w-35,h-65);ctx.stroke();ctx.fillStyle='#b4cfc1';ctx.font='20px system-ui';ctx.fillText('Temperatura (°C)',20,24);ctx.fillText('Energía suministrada →',w-280,h-20);let pts=[[105,h-100],[260,h-160],[420,h-160],[590,h-265],[750,h-265],[900,55]];ctx.strokeStyle='#37d49a';ctx.lineWidth=5;ctx.beginPath();pts.forEach((p,i)=>i?ctx.lineTo(p[0],p[1]):ctx.moveTo(p[0],p[1]));ctx.stroke();pts.forEach((p,i)=>{ctx.fillStyle='#d3f36b';ctx.beginPath();ctx.arc(p[0],p[1],6,0,Math.PI*2);ctx.fill()});ctx.fillStyle='#a8f0d2';ctx.font='bold 18px system-ui';ctx.fillText('Hielo',145,h-130);ctx.fillText('Fusión',305,h-180);ctx.fillText('Agua líquida',465,h-215);ctx.fillText('Ebullición',625,h-285);ctx.fillText('Vapor',820,38);ctx.fillStyle='#b4cfc1';ctx.font='15px system-ui';ctx.fillText('0 °C',35,h-155);ctx.fillText('100 °C',25,h-280)}
drawHeating();
const ts=document.getElementById('tempSlider'),ps=document.getElementById('presSlider');
function drawPhase(){const c=document.getElementById('phaseCanvas'),ctx=c.getContext('2d'),w=c.width,h=c.height;ctx.clearRect(0,0,w,h);const L=90,R=w-45,T=35,B=h-65;ctx.strokeStyle='#b4cfc1';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(L,T);ctx.lineTo(L,B);ctx.lineTo(R,B);ctx.stroke();ctx.fillStyle='#b4cfc1';ctx.font='19px system-ui';ctx.fillText('Presión (esquemática)',15,24);ctx.fillText('Temperatura →',R-190,h-20);ctx.fillStyle='#123e2c';ctx.fillRect(L+2,T+2,(R-L)*.33,B-T-2);ctx.fillStyle='#174d38';ctx.fillRect(L+(R-L)*.33,T+2,(R-L)*.32,B-T-2);ctx.fillStyle='#0c3028';ctx.fillRect(L+(R-L)*.65,T+2,(R-L)*.35,B-T-2);ctx.strokeStyle='#d3f36b';ctx.lineWidth=4;ctx.beginPath();ctx.moveTo(L+100,B-5);ctx.lineTo(L+260,T+150);ctx.stroke();ctx.strokeStyle='#37d49a';ctx.beginPath();ctx.moveTo(L+260,T+150);ctx.bezierCurveTo(L+390,T+100,L+500,T+95,R-60,T+70);ctx.stroke();ctx.strokeStyle='#a8f0d2';ctx.beginPath();ctx.moveTo(L+100,B-5);ctx.bezierCurveTo(L+180,B-140,L+220,T+180,L+260,T+150);ctx.stroke();ctx.fillStyle='#edf9f2';ctx.font='bold 24px system-ui';ctx.fillText('Sólido',L+40,B-35);ctx.fillText('Líquido',L+320,T+85);ctx.fillText('Gas',R-130,B-50);ctx.fillStyle='#ffbd69';ctx.beginPath();ctx.arc(L+260,T+150,8,0,Math.PI*2);ctx.fill();ctx.fillText('Punto triple*',L+275,T+155);const temp=+ts.value,pressure=+ps.value;const x=L+((temp+80)/260)*(R-L);const y=B-(Math.log10(pressure)/2)*(B-T);ctx.fillStyle='#ff8585';ctx.beginPath();ctx.arc(x,Math.max(T+8,Math.min(B-8,y)),10,0,Math.PI*2);ctx.fill();document.getElementById('tempVal').textContent=temp+' °C';document.getElementById('presVal').textContent=(pressure/10).toFixed(1).replace('.',',')+' atm (escala didáctica)';let state;if(temp<0)state='A temperaturas bajo 0 °C y en condiciones ordinarias, el agua suele estar en fase sólida.';else if(temp<100)state='A esta temperatura y cerca de 1 atm, el agua suele estar en fase líquida.';else state='A esta temperatura y cerca de 1 atm, el agua suele estar en fase gaseosa.';document.getElementById('phaseDesc').textContent=state+' El punto rojo indica la condición seleccionada de forma aproximada; las fronteras del dibujo no son cuantitativas.'}
